<view class="page">
  <view class="card">
    <view class="updated">更新日期：2026 年 10 月 22 日</view>
    <view class="intro">{{privacy ? '了解你填写的信息如何保存、共享和删除。' : '使用拼途前，请阅读以下约定。你可以返回首页使用无需登录的功能。'}}</view>
    <block wx:for="{{sections}}" wx:key="title"><view class="section-title">{{item.title}}</view><view class="paragraph">{{item.text}}</view></block>
    <button wx:if="{{privacy}}" class="btn secondary" bindtap="openNativePrivacy">查看微信隐私保护指引</button>
  </view>
</view>
