.page { min-height:100vh; box-sizing:border-box; padding:16px 16px calc(24px + env(safe-area-inset-bottom)); background:#F6F3EA; color:#1B2A2E; }
.header { display:flex; align-items:center; gap:9px; margin-bottom:12px; }
.back { display:flex; align-items:center; justify-content:center; width:32px; height:32px; border:1px solid #DED8C6; border-radius:50%; background:#FFFDF6; color:#0F3D36; font-size:24px; line-height:1; }
.title { color:#0F3D36; font-size:17px; font-weight:800; }
.card { padding:16px; border:1px solid #DED8C6; border-radius:14px; background:#FFFDF6; }
.updated { margin-bottom:10px; color:#74807F; font-size:10.5px; }
.intro { margin-bottom:14px; color:#344744; font-size:12.5px; font-weight:600; line-height:1.75; }
.section-title { margin:14px 0 5px; color:#0F3D36; font-size:13.5px; font-weight:800; }
.paragraph { color:#4C5C5B; font-size:12px; line-height:1.8; }
.page{padding-top:10px;padding-bottom:calc(16px + env(safe-area-inset-bottom))}.header{margin-bottom:8px}.card{padding:12px}.updated{margin-bottom:7px}.intro{margin-bottom:9px;line-height:1.65}.section-title{margin:10px 0 4px}.paragraph{line-height:1.7}
