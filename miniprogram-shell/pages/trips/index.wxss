.trips-page{padding-top:15px}.trips-header{display:flex;align-items:center;gap:7px;margin-bottom:14px}.trips-mark{width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:7px;background:#0F3D36}.trips-mark image{width:14px;height:14px}.trips-label{margin-bottom:9px}.trip-row{display:flex;align-items:center;gap:9px;box-sizing:border-box;min-height:56px;padding:10px 9px;margin-bottom:7px;border:1px solid #DED8C6;border-radius:12px;background:#FFFDF6}.trip-icon{width:33px;height:33px;flex:0 0 33px;display:flex;align-items:center;justify-content:center;border-radius:9px}.trip-icon image{width:17px;height:17px}.trip-icon-meetup{background:#DCE7EC}.trip-icon-ledger{background:#F1DDE5}.trip-copy{flex:1;min-width:0}.trip-name{color:#1B2A2E;font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.trip-meta{margin-top:2.5px;color:#4C5C5B;font-size:10px;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.trip-total{flex:0 0 auto;color:#0F3D36;font-size:13.5px;font-weight:800}.trip-arrow{flex:0 0 auto;color:#4C5C5B;font-size:19px}.state-card{display:flex;align-items:center;gap:7px;box-sizing:border-box;padding:14px;margin-bottom:9px;border:1px solid #DED8C6;border-radius:12px;background:#FFFDF6;color:#4C5C5B;font-size:11.5px;line-height:1.5}.state-spinner{width:13px;height:13px;border:1.5px solid #DCE7EC;border-top-color:#0F3D36;border-radius:50%}.error-state{border-color:#DFC0BA;background:#FFF6F1;color:#9C433A}.empty-state{display:block;padding:24px 14px;text-align:center}.empty-icon{color:#B8842A;font-size:27px}.empty-title{margin:4px 0;color:#1B2A2E;font-size:14px;font-weight:700}.load-more{margin-top:10px}
.trips-account-card{display:flex;align-items:center;gap:10px;box-sizing:border-box;min-height:58px;padding:8px 11px;margin-bottom:17px;border:1px solid #DED8C6;border-radius:12px;background:#FFFDF6}.trips-account-card-active{background:#F2EDE1}.trips-account-avatar{width:38px;height:38px;flex:0 0 38px;border-radius:50%;background:#DDECE7}.trips-account-avatar-placeholder{display:flex;align-items:center;justify-content:center}.trips-account-avatar-placeholder image{width:20px;height:20px}.trips-account-name{min-width:0;color:#1B2A2E;font-size:13px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.trips-login-button{min-width:0;height:32px;margin:0;padding:0 15px;border-radius:8px;background:#0F3D36;color:#FFFDF6;font-size:12px;line-height:32px}.trips-login-button::after{border:0}.trips-guest-note{margin:-3px 0 10px;padding:9px 10px;border-radius:9px;background:#F5E8C9;color:#755414;font-size:10.5px;line-height:1.55}.trips-backup-link{display:block;margin:5px 0 0;padding:0;border:0;background:transparent;color:#0F3D36;font-size:10.5px;line-height:1.5;text-decoration:underline}.trips-backup-link::after{border:0}
.trips-edit-profile{margin-left:auto;color:#0F3D36;font-size:11px}.trips-logout{height:34px;margin:0 0 18px;border:1px solid #C9C1AF;border-radius:9px;background:transparent;color:#4C5C5B;font-size:12px;line-height:32px}
