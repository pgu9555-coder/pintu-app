.trips-page{padding-top:30rpx}.trips-header{display:flex;align-items:center;gap:14rpx;margin-bottom:28rpx}.trips-mark{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;background:#0F3D36}.trips-mark image{width:28rpx;height:28rpx}.trips-label{margin-bottom:18rpx}.trip-row{display:flex;align-items:center;gap:18rpx;box-sizing:border-box;min-height:112rpx;padding:20rpx 18rpx;margin-bottom:14rpx;border:2rpx solid #DED8C6;border-radius:24rpx;background:#FFFDF6}.trip-icon{width:66rpx;height:66rpx;flex:0 0 66rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx}.trip-icon image{width:34rpx;height:34rpx}.trip-icon-meetup{background:#DCE7EC}.trip-icon-ledger{background:#F1DDE5}.trip-copy{flex:1;min-width:0}.trip-name{color:#1B2A2E;font-size:27rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.trip-meta{margin-top:5rpx;color:#4C5C5B;font-size:20rpx;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.trip-total{flex:0 0 auto;color:#0F3D36;font-size:27rpx;font-weight:800}.trip-arrow{flex:0 0 auto;color:#4C5C5B;font-size:38rpx}.state-card{display:flex;align-items:center;gap:14rpx;box-sizing:border-box;padding:28rpx;margin-bottom:18rpx;border:2rpx solid #DED8C6;border-radius:24rpx;background:#FFFDF6;color:#4C5C5B;font-size:23rpx;line-height:1.5}.state-spinner{width:26rpx;height:26rpx;border:3rpx solid #DCE7EC;border-top-color:#0F3D36;border-radius:50%}.error-state{border-color:#DFC0BA;background:#FFF6F1;color:#9C433A}.empty-state{display:block;padding:48rpx 28rpx;text-align:center}.empty-icon{color:#B8842A;font-size:54rpx}.empty-title{margin:8rpx 0;color:#1B2A2E;font-size:28rpx;font-weight:700}.load-more{margin-top:20rpx}
