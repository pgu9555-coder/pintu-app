<view class="page trips-page" style="padding-top: {{headerTopPx}}px;">
  <view class="trips-header">
    <view class="trips-mark"><image src="/assets/icons/brand-plane.svg" mode="aspectFit" /></view>
    <view class="page-title">我的行程</view>
  </view>
  <view class="trips-account-card" bindtap="profileCardTap" role="button" hover-class="trips-account-card-active">
    <image wx:if="{{accountSignedIn && accountAvatar}}" class="trips-account-avatar" src="{{accountAvatar}}" mode="aspectFill" />
    <view wx:else class="trips-account-avatar trips-account-avatar-placeholder"><image src="/assets/icons/person.svg" mode="aspectFit" /></view>
    <button wx:if="{{!accountSignedIn}}" class="trips-login-button" catchtap="profileCardTap">登录</button>
    <text wx:else class="trips-account-name">{{accountNickname}}</text>
  </view>
  <view class="section-label trips-label">本地行程</view>
  <view wx:if="{{loginRequired && localTrips.length}}" class="trips-guest-note">登录后查看账号行程；原有本机账本可通过首页“备份与迁移”保留和导入。<button class="trips-backup-link" bindtap="backupGuestTrips">先备份访客账本</button></view>
  <button class="btn secondary" style="margin:0 0 9px;" bindtap="newLocal">＋ 新建行程账本</button>
  <view wx:if="{{!localTrips.length}}" class="state-card empty-state">
    <view class="empty-icon">⌁</view><view class="empty-title">还没有本地行程</view><view class="muted">新建一趟行程后，成员和支出保存在这台设备，可从首页导出备份。</view>
  </view>
  <view
    wx:for="{{localTrips}}"
    wx:key="tripId"
    class="trip-row"
    bindtap="openLocal"
    data-id="{{item.tripId}}"
  >
    <view class="trip-icon trip-icon-ledger"><image src="/assets/icons/receipt.svg" mode="aspectFit" /></view>
    <view class="trip-copy">
      <view class="trip-name">{{item.name}}</view>
      <view class="trip-meta">本地账本 · {{item.memberCount}} 人 · {{item.expenseCount}} 笔支出</view>
    </view>
    <view wx:if="{{item.showTotal}}" class="trip-total">¥{{item.totalYuan}}</view>
    <view wx:else class="trip-arrow">›</view>
    <button catchtap="deleteLocal" data-id="{{item.tripId}}" style="flex:0 0 auto;margin:0 0 0 4px;padding:0 6px;border:0.5px solid #DFC0BA;border-radius:6px;background:#FFFDF6;color:#9C433A;font-size:10.5px;line-height:24px;">删除</button>
  </view>

  <view class="section-label trips-label">进行中的房间</view>
  <view wx:if="{{loginRequired}}" class="state-card empty-state">
    <view class="empty-icon">微</view>
    <view class="empty-title">登录后同步云端房间</view>
    <view class="muted">登录后可打开账号下的行程账本，并按微信身份找回有权限的云端房间。访客账本需先备份，再登录后导入。</view>
  </view>

  <block wx:if="{{!loginRequired}}">

  <view wx:if="{{loading}}" class="state-card"><view class="state-spinner"></view><text>正在同步你的云端房间…</text></view>
  <view wx:if="{{cloudError}}" class="state-card error-state">{{cloudError}}；为保护账号隐私，未显示云端房间的本机缓存。</view>
  <view wx:if="{{!loading && !rooms.length && !cloudError}}" class="state-card empty-state">
    <view class="empty-icon">⌁</view><view class="empty-title">还没有进行中的房间</view><view class="muted">从首页创建房间，或输入房间码加入。</view>
  </view>

  <view
    wx:for="{{rooms}}"
    wx:key="docId"
    class="trip-row"
    bindtap="open"
    data-id="{{item.docId}}"
  >
    <view class="trip-icon trip-icon-{{item.iconTone}}"><image src="{{item.typeIcon}}" mode="aspectFit" /></view>
    <view class="trip-copy">
      <view class="trip-name">{{item.room.name}}</view>
      <view class="trip-meta">{{item.typeLabel}} · {{item.memberCount || 0}} 人 · {{item.expenseCount || 0}} 笔支出 · 房号 {{item.room.code}}</view>
    </view>
    <view wx:if="{{item.showTotal}}" class="trip-total">¥{{item.totalYuan}}</view>
    <view wx:else class="trip-arrow">›</view>
    <button catchtap="roomAction" data-id="{{item.docId}}" loading="{{roomActionBusyId === item.docId}}" disabled="{{roomActionBusyId !== ''}}" style="flex:0 0 auto;margin:0 0 0 4px;padding:0 5px;border:0.5px solid #DFC0BA;border-radius:6px;background:#FFFDF6;color:#9C433A;font-size:9.5px;line-height:24px;">退出/解散</button>
  </view>

  <button wx:if="{{hasMore}}" class="btn secondary load-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">{{loadingMore ? '加载中…' : '加载更多房间'}}</button>
  </block>
</view>
