.page { min-height:100vh; box-sizing:border-box; padding:0 20px 26px; background:#F6F3EA; color:#1B2A2E; }
.brand-row { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px; }
.brand { display:flex; align-items:center; gap:8px; min-width:0; }
.brand-mark { width:26px; height:26px; border-radius:7px; background:#0F3D36; display:flex; align-items:center; justify-content:center; }
.brand-glyph { width:14px; height:14px; }
.brand-name { color:#0F3D36; font-size:17px; font-weight:700; letter-spacing:0.5px; }
.avatar-action::after, .profile-save::after, .profile-text-action::after, .privacy-link::after, .wechat-login-button::after, .wechat-login-cancel::after { border:0; }
.join-card { margin-bottom:22px; padding:14px; border:1px solid #DED8C6; border-radius:16px; background:#FFFDF6; box-shadow:0 5px 16px rgba(15,61,54,.06); }
.join-heading { display:flex; align-items:center; gap:9px; margin-bottom:11px; }
.ticket-icon { width:34px; height:34px; flex:0 0 auto; border-radius:10px; background:#F5E8C9; display:flex; align-items:center; justify-content:center; }
.ticket-glyph { width:18px; height:18px; }
.join-title { color:#1B2A2E; font-size:14px; font-weight:700; line-height:1.25; }
.join-subtitle { margin-top:2px; color:#4C5C5B; font-size:11.5px; line-height:1.45; }
.invite-notice { margin:-1px 0 9px; padding:8px 9px; border-radius:8px; background:#E7F1EC; color:#174E42; }
.invite-notice-title { font-size:12px; font-weight:700; line-height:1.35; }
.invite-notice-copy { margin-top:2px; font-size:10.5px; line-height:1.45; letter-spacing:0.25px; }
.join-input, .profile-input { box-sizing:border-box; width:100%; height:40px; padding:0 11px; border:1.5px solid #DED8C6; border-radius:10px; background:#F6F3EA; color:#1B2A2E; font-size:13px; }
.input-placeholder { color:#74807F; }
.join-code-row { display:flex; align-items:center; gap:7px; margin-top:8px; }
.code-input { flex:1; min-width:0; letter-spacing:1.5px; font-family:"IBM Plex Sans SC",sans-serif; text-transform:uppercase; }
.code-placeholder { letter-spacing:0; font-family:"IBM Plex Sans SC",sans-serif; }
.join-button { display:flex; flex:0 0 auto; align-items:center; justify-content:center; min-width:51px; height:40px; padding:0 13px; box-sizing:border-box; border-radius:10px; background:#0F3D36; color:#FFFDF6; font-size:12.5px; font-weight:700; }
.join-button-disabled { opacity:.62; }
.join-error { margin-top:7px; color:#B54C3C; font-size:11px; line-height:1.45; }
.section-label { margin:0 0 12px; color:#4C5C5B; font-size:12.5px; font-weight:600; letter-spacing:0.75px; }
.tool-list { display:flex; flex-direction:column; gap:10px; }
.tool-card { display:flex; align-items:center; gap:14px; min-height:92px; box-sizing:border-box; padding:14px; border:1px solid #DED8C6; border-radius:16px; background:#FFFDF6; }
.tool-card-active { transform:scale(.97); }
.tool-icon { width:40px; height:40px; flex:0 0 auto; border-radius:11px; display:flex; align-items:center; justify-content:center; }
.tool-icon-blue { background:#DCE7EC; color:#3E6E8E; }.tool-icon-coral { background:#F4DED3; color:#C05B3C; }.tool-icon-pink { background:#F1DDE5; color:#A8506E; }
.tool-glyph { width:21px; height:21px; }.tool-copy { flex:1; min-width:0; }.tool-title { margin-bottom:3px; color:#1B2A2E; font-size:13px; font-weight:600; line-height:1.35; }.tool-desc { color:#4C5C5B; font-size:10.5px; line-height:1.4; }.tool-chevron { width:18px; height:18px; flex:0 0 auto; opacity:.72; }
.profile-overlay { position:fixed; z-index:100; inset:0; display:flex; align-items:flex-end; background:rgba(27,42,46,.38); }
.profile-sheet { width:100%; max-height:82vh; box-sizing:border-box; overflow-y:auto; padding:8px 20px calc(20px + env(safe-area-inset-bottom)); border-radius:18px 18px 0 0; background:#FFFDF6; }
.sheet-handle { width:32px; height:4px; margin:0 auto 10px; border-radius:49.5px; background:#D8D4C9; }.sheet-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px; }.sheet-title { color:#1B2A2E; font-size:17px; font-weight:800; }.sheet-subtitle { margin-top:2px; color:#4C5C5B; font-size:11px; }.sheet-close { width:28px; height:28px; margin:-4px 0 0; padding:0; border-radius:50%; background:#F6F3EA; color:#4C5C5B; font-size:21px; font-weight:300; line-height:26px; }
.profile-head { display:flex; align-items:center; gap:9px; margin-bottom:10px; }.profile-avatar { width:44px; height:44px; border-radius:50%; background:#DCE7EC; }.profile-avatar-placeholder { display:flex; align-items:center; justify-content:center; color:#3E6E8E; font-size:17px; font-weight:700; }.avatar-action-wrap { position:relative; width:75px; height:29px; flex:0 0 75px; overflow:hidden; border-radius:14.5px; }.avatar-action { position:absolute; inset:0; width:75px !important; min-width:0 !important; max-width:75px !important; height:29px; margin:0 !important; padding:0 !important; border-radius:14.5px; background:#F5E8C9; color:#855B17; font-size:12px; line-height:29px; }.avatar-unsupported { color:#4C5C5B; font-size:11px; }
.profile-save { width:100%; height:41px; margin:9px 0 0; border-radius:8px; background:#0F3D36; color:#FFFDF6; font-size:14px; font-weight:700; line-height:41px; }.avatar-cleanup-warning { display:flex; align-items:center; justify-content:space-between; gap:6px; margin-top:8px; padding:7px 8px; border-radius:7px; background:#FFF3DD; color:#855B17; font-size:11px; }.profile-actions { display:flex; justify-content:flex-end; gap:12px; margin-top:9px; }.profile-text-action, .privacy-link { min-width:0; margin:0; padding:0; background:transparent; color:#855B17; font-size:12px; line-height:24px; }.profile-text-action.danger { color:#B54C3C; }.privacy-link { display:block; margin:5px auto 0; color:#4C5C5B; font-size:11px; }
.wechat-login-overlay { position:fixed; z-index:200; inset:0; display:flex; align-items:center; justify-content:center; box-sizing:border-box; padding:20px; padding-top:calc(20px + env(safe-area-inset-top)); padding-bottom:calc(20px + env(safe-area-inset-bottom)); background:rgba(15,35,32,.58); }
.wechat-login-dialog { position:relative; width:100%; max-width:315px; box-sizing:border-box; padding:21px 18px 15px; border:1px solid #DED8C6; border-radius:17px; background:#FFFDF6; box-shadow:0 15px 45px rgba(15,35,32,.2); text-align:center; }
.wechat-login-close { position:absolute; top:9px; right:10px; display:flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:50%; background:#F6F3EA; color:#4C5C5B; font-size:20px; line-height:1; }
.wechat-login-mark { display:flex; align-items:center; justify-content:center; width:44px; height:44px; margin:0 auto 11px; border-radius:13px; background:#DDECE7; }
.wechat-login-mark image { width:23px; height:23px; }
.wechat-login-title { color:#1B2A2E; font-size:18px; font-weight:800; line-height:1.3; }
.wechat-login-subtitle { margin:6px auto 12px; color:#4C5C5B; font-size:11.5px; line-height:1.55; }
.wechat-login-points { padding:10px; border-radius:10px; background:#F6F3EA; text-align:left; }
.wechat-login-point { display:flex; align-items:flex-start; gap:6px; padding:4px 0; color:#344744; font-size:11px; line-height:1.5; }
.wechat-login-check { flex:0 0 auto; color:#2E745F; font-weight:800; }
.agreement-hint { margin-top:9px; color:#855B17; font-size:10px; line-height:1.5; text-align:left; }
.agreement-row { display:flex; align-items:flex-start; gap:7px; margin-top:11px; padding:2px 0; text-align:left; }
.agreement-checkbox { display:flex; flex:0 0 17px; align-items:center; justify-content:center; width:17px; height:17px; box-sizing:border-box; margin-top:1px; border:1px solid #9AA5A2; border-radius:4px; background:#FFFDF6; color:#FFFDF6; font-size:12px; font-weight:800; line-height:1; }
.agreement-checkbox-checked { border-color:#0F3D36; background:#0F3D36; }
.agreement-copy { color:#4C5C5B; font-size:10.5px; line-height:1.65; }
.agreement-link { color:#2E6283; }
.wechat-login-button { width:100%; height:42px; margin:11px 0 0; border-radius:10px; background:#0F3D36; color:#FFFDF6; font-size:13.5px; font-weight:800; line-height:42px; }
.wechat-login-button-disabled { opacity:.45; }
.wechat-login-cancel { min-width:0; margin:5px auto 0; padding:0 10px; background:transparent; color:#4C5C5B; font-size:11px; line-height:27px; }

.brand-row { margin-bottom:12px; }
.service-links { display:flex;flex-wrap:nowrap;align-items:center;justify-content:space-between;gap:6px;margin:0 0 16px;white-space:nowrap; }
.service-links button { flex:0 1 auto;min-width:0;margin:0;padding:0;border:0;background:transparent;color:#0F3D36;font-size:10.5px;line-height:1.6;text-decoration:underline;white-space:nowrap; }
.join-card { padding:14px;border-radius:16px;margin-bottom:22px; }
.join-input { font-size:14px;border-width:1px; }
.tool-card { min-height:90px;border-radius:16px;padding:14px;gap:14px; }
.profile-overlay { justify-content:center; }
.profile-sheet { max-width:480px; }
.join-profile-name{display:flex;align-items:center;justify-content:space-between;color:#1B2A2E}.join-profile-name text{color:#74807F;font-size:10px}
/* Reduced vertical whitespace while preserving tap targets and intrinsic heights. */
.brand-row{margin-bottom:8px}.service-links{margin-bottom:10px}.join-card{padding:12px;margin-bottom:14px}.join-heading{margin-bottom:8px}.tool-list{gap:8px}.tool-card{min-height:76px;padding:11px;gap:11px}.tool-icon{width:36px;height:36px}.tool-title{font-size:13px}.tool-desc{font-size:11px;line-height:1.45}.profile-overlay .profile-sheet{padding-top:8px}.profile-sheet .sheet-header{margin-bottom:8px}
.service-links{flex-wrap:wrap;gap:0 8px}.service-links button{width:auto;flex:0 0 auto;min-height:44px;display:flex;align-items:center;justify-content:center;white-space:normal}
