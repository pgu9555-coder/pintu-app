<view class="page">
  <view class="service-links" aria-label="服务与数据">
    <button bindtap="openPrivacyNotice">隐私说明</button><button bindtap="openServiceAgreement">用户协议</button><button bindtap="contactDeveloper">联系开发者</button><button bindtap="openDataTools">备份与迁移</button>
  </view>

  <view class="join-card">
    <view class="join-heading">
      <view class="ticket-icon"><image class="ticket-glyph" src="/assets/icons/ticket.svg" mode="aspectFit" /></view>
      <view>
        <view class="join-title">加入房间</view>
        <view class="join-subtitle">输入任意碰面码或账本码，自动进入对应功能。</view>
      </view>
    </view>
    <view class="join-input join-profile-name">{{name || '微信用户'}} <text>将以此名称加入</text></view>
    <view wx:if="{{inviteType}}" class="invite-notice">
      <view class="invite-notice-title">{{inviteLabel}}房间邀请</view>
      <view class="invite-notice-copy">房间码 {{code}}。将使用你的资料名称，点击加入以确认。</view>
    </view>
    <view class="join-code-row">
      <input class="join-input code-input" placeholder="8 位房间码" placeholder-class="input-placeholder code-placeholder" value="{{code}}" maxlength="8" bindinput="codeInput" bindconfirm="join" confirm-type="go" />
      <view class="join-button {{busy ? 'join-button-disabled' : ''}}" bindtap="join" role="button">{{busy ? '加入中' : (inviteType ? '确认加入' : '加入')}}</view>
    </view>
    <view wx:if="{{profileError}}" class="join-error">{{profileError}}。<button class="text-action" bindtap="retryProfile">重新识别</button></view>
    <view wx:if="{{profileRouteError}}" class="join-error">{{profileRouteError}} <button class="text-action" bindtap="retryPendingProfile">重试</button></view>
    <view wx:if="{{joinError}}" class="join-error">{{joinError}}</view>
  </view>

  <view class="section-label">用完即走</view>
  <view class="tool-list">
    <view class="tool-card" bindtap="openMidpoint" role="button" hover-class="tool-card-active">
      <view class="tool-icon tool-icon-blue"><image class="tool-glyph" src="/assets/icons/midpoint.svg" mode="aspectFit" /></view>
      <view class="tool-copy">
        <view class="tool-title">公平碰面 · 盲盒吃喝</view>
        <view class="tool-desc">寻找合适的碰面点</view>
        <view class="tool-desc">顺手滑一滑选好去处</view>
      </view>
      <image class="tool-chevron" src="/assets/icons/arrow-right.svg" mode="aspectFit" />
    </view>
    <view class="tool-card" bindtap="openSpinner" role="button" hover-class="tool-card-active">
      <view class="tool-icon tool-icon-coral"><image class="tool-glyph" src="/assets/icons/target.svg" mode="aspectFit" /></view>
      <view class="tool-copy">
        <view class="tool-title">谁买单 · 转盘</view>
        <view class="tool-desc">这顿谁请？</view>
        <view class="tool-desc">转一转，天意决定</view>
      </view>
      <image class="tool-chevron" src="/assets/icons/arrow-right.svg" mode="aspectFit" />
    </view>
    <view class="tool-card" bindtap="openLedger" role="button" hover-class="tool-card-active">
      <view class="tool-icon tool-icon-pink"><image class="tool-glyph" src="/assets/icons/receipt.svg" mode="aspectFit" /></view>
      <view class="tool-copy">
        <view class="tool-title">行程账本</view>
        <view class="tool-desc">出去玩几天，各付各的钱</view>
        <view class="tool-desc">最后一键算清谁该转给谁</view>
      </view>
      <image class="tool-chevron" src="/assets/icons/arrow-right.svg" mode="aspectFit" />
    </view>
  </view>

  <view wx:if="{{profilePanelOpen}}" class="profile-overlay" bindtap="closeProfilePanel">
    <view class="profile-sheet" catchtap="preventClose">
      <view class="sheet-handle"></view>
      <view class="sheet-header">
        <view>
          <view class="sheet-title">微信账号</view>
          <view class="sheet-subtitle">资料仅归你的微信账号</view>
        </view>
        <view class="sheet-close" bindtap="closeProfilePanel" role="button" aria-label="关闭">×</view>
      </view>
      <view class="profile-head">
        <image wx:if="{{profileAvatarPreview}}" class="profile-avatar" src="{{profileAvatarPreview}}" mode="aspectFill" />
        <view wx:else class="profile-avatar profile-avatar-placeholder">微</view>
        <view wx:if="{{canChooseAvatar}}" class="avatar-action-wrap">
          <button class="avatar-action" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{profileBusy || !profileLoaded}}">换头像</button>
        </view>
        <view wx:else class="avatar-unsupported">当前微信版本不支持换头像</view>
      </view>
      <input class="profile-input" type="nickname" placeholder="微信昵称" placeholder-class="input-placeholder" value="{{profileNickname}}" maxlength="24" bindinput="profileNicknameInput" disabled="{{!profileLoaded || profileBusy}}" />
      <button class="profile-save" bindtap="saveProfile" loading="{{profileBusy}}" disabled="{{profileBusy || !profileLoaded}}">保存微信资料</button>
      <view wx:if="{{profileAvatarCleanupPending}}" class="avatar-cleanup-warning">
        <text>有 {{profileAvatarCleanupPending}} 个旧头像文件待清理</text>
        <button class="profile-text-action" bindtap="retryAvatarCleanup" disabled="{{profileBusy}}">重试清理</button>
      </view>
      <view class="profile-actions">
        <button class="profile-text-action" bindtap="removeAvatar" disabled="{{profileBusy || !profileLoaded}}">移除头像</button>
        <button class="profile-text-action danger" bindtap="deleteProfile" disabled="{{profileBusy || !profileLoaded}}">删除云端资料</button>
      </view>
      <button class="privacy-link" bindtap="openPrivacy">隐私保护指引</button>
    </view>
  </view>

  <view wx:if="{{wechatLoginVisible}}" class="wechat-login-overlay" catchtouchmove="preventClose" bindtap="cancelWechatLogin">
    <view class="wechat-login-dialog" catchtap="preventClose">
      <view class="wechat-login-close" bindtap="cancelWechatLogin" role="button" aria-label="暂不登录">×</view>
      <view class="wechat-login-mark"><image src="/assets/icons/person.svg" mode="aspectFit" /></view>
      <view class="wechat-login-title">登录后，继续相聚</view>
      <view class="wechat-login-subtitle">登录后即可使用{{loginPurpose}}。</view>
      <view class="agreement-hint">不会自动读取头像或昵称。请勾选同意以下协议后登录。</view>
      <view class="agreement-row" bindtap="togglePrivacyConsent" role="checkbox" aria-checked="{{privacyConsentChecked}}">
        <view class="agreement-checkbox {{privacyConsentChecked ? 'agreement-checkbox-checked' : ''}}">{{privacyConsentChecked ? '✓' : ''}}</view>
        <view class="agreement-copy">
          <text>我已阅读并同意</text>
          <text class="agreement-link" catchtap="openServiceAgreement">《用户服务协议》</text>
          <text>和</text>
          <text class="agreement-link" catchtap="openPrivacy">《隐私保护指引》</text>
        </view>
      </view>
      <button class="wechat-login-button {{privacyConsentChecked ? '' : 'wechat-login-button-disabled'}}" bindtap="confirmWechatLogin" loading="{{wechatLoginBusy}}" disabled="{{wechatLoginBusy || !privacyConsentChecked}}">微信登录</button>
      <button class="wechat-login-cancel" bindtap="cancelWechatLogin" disabled="{{wechatLoginBusy}}">暂不登录</button>
    </view>
  </view>
</view>
