.member-row,.member-actions{display:flex;align-items:center}.member-row{justify-content:space-between;gap:16rpx;padding:10rpx 0;border-bottom:1rpx solid #F0E8DA}.member-row>view:first-child{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.member-actions{flex:0 0 auto;justify-content:flex-end;gap:12rpx}.member-actions .text-btn{box-sizing:border-box;flex:none;width:104rpx;min-width:104rpx;padding:0}
.room-actions,.summary-row,.expense-top,.expense-actions{display:flex;align-items:center}.room-actions{gap:16rpx;margin-top:8rpx}.room-actions .compact{flex:1;min-width:0}.section-title{font-size:32rpx;font-weight:700}.member-list{margin:14rpx 0}.split-label{margin-top:18rpx}.check{display:inline-block;margin:14rpx 26rpx 10rpx 0}.summary-row{justify-content:space-between;margin-bottom:8rpx}.total{color:#B8842A;font-size:30rpx;font-weight:700}.expense{padding:22rpx 0;border-bottom:1rpx solid #E6DBC8}.expense:last-child{border:0}.expense-top{justify-content:space-between;font-weight:600}.expense-actions{gap:14rpx;margin-top:12rpx}.text-btn{display:inline-flex;align-items:center;justify-content:center;margin:0;padding:0 18rpx;min-width:104rpx;height:58rpx;font-size:25rpx;line-height:58rpx;border:1rpx solid #D9CDBA;border-radius:10rpx;background:#FFFDF8;color:#143D35}.delete-btn{color:#9C433A;border-color:#DFC0BA}
