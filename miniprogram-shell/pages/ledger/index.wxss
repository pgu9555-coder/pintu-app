.ledger-page{padding-bottom:40px}.collaboration-card{padding:12px}.ledger-room-icon{background:#F0DDE7;color:#A64F71;font-weight:800}.local-note{padding:8px 9px;border-radius:7px;background:#F6F3EA;color:#4C5C5B;font-size:11px;line-height:1.5}.code-input{text-transform:uppercase;letter-spacing:1.5px}.empty-copy{padding:11px 0;color:#A39D90;font-size:12px;line-height:1.5}.empty-copy.centered{text-align:center}.member-row{display:flex;align-items:center;gap:8px;min-width:0;padding:8px 0;border-bottom:0.5px solid #E7E0D1}.avatar{width:24px;height:24px;flex:0 0 24px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#0F3D36;color:#FFFDF6;font-size:10.5px;font-weight:700}.avatar-1{background:#B8842A}.member-copy{flex:1;min-width:0}.member-name{font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.member-kind{margin-top:1.5px;color:#7C8580;font-size:10px;white-space:nowrap}.member-actions{display:flex;flex:0 0 auto;gap:4px}.text-btn,.edit-pill,.delete-dot{display:flex;align-items:center;justify-content:center;box-sizing:border-box;margin:0;background:#FFFDF6}.text-btn{width:43px;min-width:43px;max-width:43px;height:26px;flex:0 0 43px;padding:0;border:0.5px solid #D9CDBA;border-radius:6px;color:#0F3D36;font-size:10.5px;line-height:26px;overflow:hidden}.delete-btn{color:#9C433A}.add-member-row{display:flex;align-items:center;gap:6px;margin-top:8px}.add-member-row .input{flex:1;min-width:0}.add-button{width:40px;height:40px;display:flex;align-items:center;justify-content:center;margin:0;padding:0;border-radius:9px;background:#0F3D36;color:#FFFDF6;font-size:22px;font-weight:300;line-height:40px}.money-row{position:relative;display:flex;align-items:center}.amount-input{padding-left:29px}.currency{position:absolute;left:12px;color:#B8842A;font-size:14px;font-weight:700}.choice-list{display:flex;flex-wrap:wrap;gap:6px}.person-chip{display:flex;align-items:center;gap:4.5px;box-sizing:border-box;max-width:100%;min-height:32px;padding:4px 9px 4px 4.5px;border:1px solid #DED8C6;border-radius:499.5px;background:#FFFDF6;color:#4C5C5B;font-size:11.5px}.person-chip.selected{border-color:#0F3D36;background:#0F3D36;color:#FFFDF6}.chip-avatar{width:21px;height:21px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#B8842A;color:#FFFDF6;font-size:9px;font-weight:700}.save-expense{margin-top:14px}.expense-list{margin-top:3px}.expense-row{position:relative;display:flex;align-items:center;gap:7px;padding:10px 9px;margin-bottom:6px;border:1px solid #DED8C6;border-radius:11px;background:#FFFDF6}.expense-copy{flex:1;min-width:0}.expense-name{font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.expense-meta{margin-top:2px;color:#4C5C5B;font-size:10px;line-height:1.4}.expense-right{flex:0 0 auto;text-align:right}.expense-amount{color:#0F3D36;font-size:13.5px;font-weight:800}.edit-pill{height:22px;margin:3px 0 0 auto;padding:0 7px;border:0.5px solid #DED8C6;border-radius:499.5px;color:#3E6E8E;font-size:10px;line-height:22px}.delete-dot{position:absolute;top:-6px;right:-6px;width:21px;height:21px;padding:0;border:1.5px solid #FFFDF6;border-radius:50%;background:#C05B3C;color:#FFFDF6;font-size:14.5px;line-height:18px}.total-card{padding:21px 14px;margin-bottom:12px;border-radius:14px;background:#0F3D36;color:#FFFDF6;text-align:center}.total-caption{font-size:11.5px;opacity:.78}.total-number{margin:5px 0 2px;font-size:30px;font-weight:800;letter-spacing:0.5px}.total-sub{font-size:10.5px;opacity:.72}.balance-row,.settlement-row{display:flex;align-items:center;gap:7px;padding:9px 0;border-bottom:0.5px solid #E7E0D1}.balance-row:last-child,.settlement-row:last-child{border-bottom:0}.balance-name{flex:1;font-size:13px;font-weight:600}.balance-value{font-size:12px;font-weight:700}.balance-positive{color:#2E745F}.balance-negative{color:#C05B3C}.balance-neutral{color:#7C8580}.transfer-copy{flex:1;display:flex;align-items:center;