.expense-editor-backdrop { position:fixed;inset:0;z-index:100;background:rgba(15,25,22,.48); }
.expense-editor-sheet { position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;max-height:88vh;overflow-y:auto;z-index:101;margin:0;padding:18px 20px calc(20px + env(safe-area-inset-bottom));border-radius:20px 20px 0 0;border:0; }
.editor-handle { width:30px;height:4px;margin:0 auto 16px;border-radius:4px;background:#D8D5C8; }
.editor-close { position:absolute;top:12px;right:16px;width:32px;height:32px;margin:0;padding:0;line-height:30px;background:#F6F3EA;border:1px solid #DED8C6;border-radius:50%;font-size:22px;color:#4C5C5B; }
.expense-editor-sheet .section-title { padding-right:28px; }
.total-card { background:#F5E8C9;color:#0F3D36;border:1px solid #DED8C6;padding:20px; }
.total-number { font-size:36px;font-weight:600; }
.person-chip.selected { background:#0F3D36;color:#FFFDF6; }
.collaboration-card .room-entry-row { gap:6px; }
