<view class="page ledger-page" style="padding-top: {{headerTopPx}}px;">
  <view class="page-header">
    <view class="back-button" bindtap="goBack">‹</view>
    <view class="page-title">行程账本</view>
    <view class="page-status">● {{syncText}}</view>
  </view>
  <view wx:if="{{syncPending}}" style="margin-bottom:18rpx;padding:16rpx 18rpx;border-radius:14rpx;background:#FFF4D9;color:#8B641F;font-size:22rpx;line-height:1.5;">修改已保存在本机，恢复网络后会自动同步。</view>

  <view class="card collaboration-card">
    <view class="room-card-head">
      <view class="room-card-icon ledger-room-icon">账</view>
      <view>
        <view class="room-card-title">多人共享账本</view>
        <view class="room-card-sub">账本码与碰面码互不通用；加入后所有支出实时同步。</view>
      </view>
    </view>

    <block wx:if="{{room}}">
      <view class="active-room">
        <view class="active-room-main">
          <view class="active-room-label">正在共享{{ledger.name || room.name}} · 房间码</view>
          <view class="active-room-code">{{room.code}}</view>
        </view>
        <button class="text-action" bindtap="copyCode" disabled="{{busy}}">复制</button>
        <button class="text-action" open-type="share" disabled="{{busy}}">邀请</button>
        <button class="text-action" bindtap="exitRoom" disabled="{{busy}}">{{isOwner ? '解散' : '退出'}}</button>
      </view>
    </block>

    <block wx:else>
      <view class="local-note">当前是本机账本；创建或加入房间后会切换为云端共享账本。</view>
      <input class="input" placeholder="你的名字" value="{{name}}" maxlength="24" bindinput="nameInput" />
      <button class="btn" bindtap="create" loading="{{busy}}" disabled="{{busy}}">创建共享账本</button>
      <view class="room-entry-row">
        <input class="input code-input" placeholder="输入 8 位账本码" value="{{code}}" maxlength="8" bindinput="codeInput" />
        <button class="room-small-button outline" bindtap="join" loading="{{busy}}" disabled="{{busy}}">加入</button>
      </view>
    </block>
  </view>

  <view class="stepper">
    <view class="step-node {{step === 1 ? 'active' : step > 1 ? 'done' : ''}}" bindtap="goStep" data-step="1">
      <view class="step-dot">1</view><view class="step-name">同行的人</view>
    </view>
    <view class="step-link {{step > 1 ? 'active' : ''}}"></view>
    <view class="step-node {{step === 2 ? 'active' : step > 2 ? 'done' : ''}}" bindtap="goStep" data-step="2">
      <view class="step-dot">2</view><view class="step-name">记支出</view>
    </view>
    <view class="step-link {{step > 2 ? 'active' : ''}}"></view>
    <view class="step-node {{step === 3 ? 'active' : ''}}" bindtap="goStep" data-step="3">
      <view class="step-dot">3</view><view class="step-name">谁转给谁</view>
    </view>
  </view>

  <block wx:if="{{step === 1}}">
    <view class="card">
      <view class="section-title">这趟行程</view>
      <input class="input" placeholder="例如：五一上海游" value="{{tripName}}" maxlength="20" bindinput="tripNameInput" bindblur="saveTripName" />
      <view class="section-label">同行的人</view>
      <view wx:if="{{!ledger.members.length}}" class="empty-copy">先把同行的人加进来，至少需要 2 人。</view>
      <view wx:for="{{ledger.members}}" wx:key="id" class="member-row">
        <view class="avatar avatar-{{index % 2}}">{{item.initial}}</view>
        <view class="member-copy">
          <view class="member-name">{{item.name}}</view>
          <view class="member-kind">{{item.uid ? '房间成员' : '账本成员'}}</view>
        </view>
        <view wx:if="{{!item.uid}}" class="member-actions">
          <button class="text-btn" catchtap="renameMember" data-id="{{item.id}}" disabled="{{busy}}">改名</button>
          <button class="text-btn delete-btn" catchtap="removeMember" data-id="{{item.id}}" disabled="{{busy}}">移除</button>
        </view>
      </view>
      <view class="add-member-row">
        <input class="input" placeholder="添加同行人名字" value="{{memberName}}" maxlength="12" bindinput="memberInput" />
        <button class="add-button" bindtap="addMember" loading="{{busy}}" disabled="{{busy}}">＋</button>
      </view>
    </view>
  </block>

  <block wx:if="{{step === 2}}">
    <view class="card expense-form-card">
      <view class="section-title">{{editingId ? '修改这笔支出' : '加一笔支出'}}</view>
      <input class="input" placeholder="花在哪里了，如 酒店 / 机票 / 晚餐" value="{{desc}}" maxlength="20" bindinput="descInput" />
      <view class="money-row">
        <input class="input amount-input" type="digit" placeholder="金额" value="{{amount}}" bindinput="amountInput" />
        <view class="currency">¥</view>
      </view>

      <view class="section-label">谁付的钱</view>
      <view class="choice-list">
        <view wx:for="{{ledger.members}}" wx:key="id" class="person-chip {{item.payerSelected ? 'selected' : ''}}" bindtap="selectPayer" data-index="{{index}}">
          <view class="chip-avatar">{{item.initial}}</view><text>{{item.name}}</text>
        </view>
      </view>

      <view class="section-label">谁要平摊这笔（默认全选）</view>
      <view class="choice-list">
        <view wx:for="{{ledger.members}}" wx:key="id" class="person-chip {{item.checked ? 'selected' : ''}}" bindtap="toggleSplit" data-id="{{item.id}}">
          <view class="chip-avatar">{{item.initial}}</view><text>{{item.name}}</text>
        </view>
      </view>

      <button class="btn save-expense" bindtap="saveExpense" loading="{{busy}}" disabled="{{busy}}">{{editingId ? '保存修改' : '＋ 添加支出'}}</button>
      <button wx:if="{{editingId}}" class="btn secondary" bindtap="cancelEdit" disabled="{{busy}}">取消修改</button>
    </view>

    <view class="expense-list">
      <view wx:if="{{!ledger.expenses.length}}" class="empty-copy centered">还没有支出记录，从上面添加第一笔</view>
      <view wx:for="{{ledger.expenses}}" wx:key="id" class="expense-row">
        <view class="avatar">{{item.payerInitial}}</view>
        <view class="expense-copy">
          <view class="expense-name">{{item.desc}}</view>
          <view class="expense-meta">{{item.payerName}} 付 · {{item.splitNames}} 平摊</view>
        </view>
        <view class="expense-right">
          <view class="expense-amount">¥{{item.amountYuan}}</view>
          <view class="edit-pill" catchtap="editExpense" data-id="{{item.id}}">修改</view>
        </view>
        <view class="delete-dot" catchtap="deleteExpense" data-id="{{item.id}}">×</view>
      </view>
    </view>
  </block>

  <block wx:if="{{step === 3}}">
    <view wx:if="{{settlementUpdated}}" class="settlement-updated" style="margin-bottom:20rpx;padding:18rpx 20rpx;border-radius:16rpx;background:#EAF2F7;color:#3E6E8E;font-size:23rpx;line-height:1.5;">账本刚刚有更新，下面的结算结果已自动重新计算。</view>
    <view class="total-card">
      <view class="total-caption">本次总支出</view>
      <view class="total-number">¥{{totalYuan}}</view>
      <view class="total-sub">{{ledger.members.length}} 人 · {{ledger.expenses.length}} 笔支出</view>
    </view>

    <view class="card">
      <view class="section-title">每个人的结果</view>
      <view wx:for="{{balanceRows}}" wx:key="id" class="balance-row">
        <view class="avatar">{{item.initial}}</view>
        <view class="balance-name">{{item.name}}</view>
        <view class="balance-value balance-{{item.tone}}">{{item.status}}<text wx:if="{{item.yuan !== '0.00'}}"> ¥{{item.yuan}}</text></view>
      </view>
      <view wx:if="{{!balanceRows.length}}" class="empty-copy">还没有同行人。</view>
    </view>

    <view class="card">
      <view class="section-title">{{settlementExact ? '最少转账方案' : '推荐转账方案'}}</view>
      <view wx:for="{{settlements}}" wx:key="key" class="settlement-row">
        <view class="transfer-copy"><text>{{item.from}}</text><text class="arrow">→</text><text>{{item.to}}</text></view>
        <view class="transfer-amount">¥{{item.yuan}}</view>
      </view>
      <view wx:if="{{!settlements.length}}" class="settled-state">✓ 大家已经结清</view>
      <view class="verify-strip" style="padding:18rpx 0 4rpx;color:#4C5C5B;text-align:center;font-size:22rpx;line-height:1.5;">✓ {{settlementVerifyText}}</view>
    </view>
  </block>

  <view class="nav-foot">
    <button wx:if="{{step > 1}}" class="btn secondary" bindtap="previousStep">上一步</button>
    <button wx:if="{{step < 3}}" class="btn" bindtap="nextStep">{{step === 1 ? '开始记账' : '算清楚！'}}</button>
    <button wx:else class="btn" bindtap="finishTrip">完成</button>
  </view>
</view>
