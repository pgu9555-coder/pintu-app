<view class="page spinner-page" style="padding-top: {{headerTopPx}}px;">
  <view class="page-header">
    <view class="back-button" bindtap="goBack">‹</view>
    <view class="page-title">谁买单 · 转盘</view>
  </view>

  <view class="spin-sub">由一个人把在场所有人的名字都填进来（转盘不用房间码，一台手机大家围着转就行），然后转一转，天意决定这顿谁买单 🎲</view>

  <view class="decision-row">
    <text class="decision-label">决定：</text>
    <input class="decision-input" maxlength="10" value="{{decision}}" bindinput="decisionInput" disabled="{{spinning}}" />
  </view>

  <canvas class="wheel-render-canvas" canvas-id="spinnerCanvas" width="{{canvasSize}}" height="{{canvasSize}}"></canvas>

  <view class="wheel-stage">
    <view class="wheel-pointer {{spinning && !motionReduced ? 'wheel-pointer-ticking' : ''}}"></view>
    <view class="wheel-rotor" animation="{{wheelAnimation}}">
      <image wx:if="{{wheelImage}}" class="wheel-image" src="{{wheelImage}}" mode="aspectFit"></image>
      <view wx:else class="wheel-placeholder">转盘准备中…</view>
    </view>
    <view class="wheel-center {{spinning || !wheelReady ? 'wheel-center-busy' : ''}}" catchtap="spin">{{wheelReady ? spinButtonText : '准备'}}</view>
  </view>

  <view class="spin-result {{result ? 'spin-result-show' : ''}} spin-result-{{resultMode}}">{{result}}</view>

  <view class="section-label people-label">在场的人</view>
  <view class="people-card">
    <view class="add-row">
      <input class="name-input" maxlength="8" placeholder="加一个名字" value="{{newName}}" bindinput="nameInput" bindconfirm="add" confirm-type="done" disabled="{{spinning}}" />
      <view class="add-button {{spinning ? 'add-button-disabled' : ''}}" catchtap="add">＋</view>
    </view>
    <view wx:if="{{!names.length}}" class="empty-row">还没有人，从上面加第一个</view>
    <view wx:for="{{names}}" wx:key="*this" class="person-row">
      <view class="person-avatar avatar-{{index}}">{{item[0]}}</view>
      <view class="person-name">{{item}}</view>
      <view class="remove-button {{spinning ? 'remove-button-disabled' : ''}}" catchtap="remove" data-index="{{index}}">×</view>
    </view>
  </view>
</view>
