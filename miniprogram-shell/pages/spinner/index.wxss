.spinner-page { padding-bottom:calc(45px + env(safe-area-inset-bottom)); padding-bottom:calc(45px + constant(safe-area-inset-bottom)); }
.spin-sub { margin:2px 0 14px; color:#4C5C5B; font-size:12px; line-height:1.62; }
.decision-row { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:10px; }
.decision-label { flex:0 0 auto; color:#4C5C5B; font-size:12px; }
.decision-input { width:125px; max-width:100%; height:36px; box-sizing:border-box; padding:0 10px; border:1px solid #DED8C6; border-radius:9px; background:#FFFDF6; color:#1B2A2E; font-size:14px; }
.wheel-render-canvas { position:fixed; left:-10000px; top:0; width:280px; height:280px; opacity:0; pointer-events:none; }
.wheel-stage { position:relative; width:280px; max-width:100%; height:290px; margin:3px auto 6px; }
.wheel-pointer { position:absolute; z-index:5; top:-1px; left:50%; width:0; height:0; transform:translate3d(-50%,0,0); -webkit-transform:translate3d(-50%,0,0); border-left:12px solid transparent; border-right:12px solid transparent; border-top:21px solid #1B2A2E; filter:drop-shadow(0 2px 2px rgba(0,0,0,.18)); transform-origin:50% 0; -webkit-backface-visibility:hidden; backface-visibility:hidden; }
.wheel-pointer-ticking { animation:wheel-pointer-tick .14s ease-in-out infinite alternate; }
.wheel-rotor { position:absolute; left:0; top:10px; width:280px; height:280px; max-width:100%; border-radius:50%; overflow:hidden; background:#EDE8DA; box-shadow:0 9px 24px rgba(27,42,46,.18); transform-origin:50% 50%; -webkit-transform-origin:50% 50%; will-change:transform; -webkit-backface-visibility:hidden; backface-visibility:hidden; }
.wheel-image { width:100%; height:100%; display:block; border-radius:50%; }
.wheel-placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#8B928D; font-size:12px; }
.wheel-center { position:absolute; z-index:6; left:50%; top:150px; width:56px; height:56px; transform:translate(-50%,-50%); display:flex; align-items:center; justify-content:center; border:3.5px solid #FFFDF6; border-radius:50%; background:#0F3D36; color:#FFFDF6; font-size:14px; font-weight:800; letter-spacing:0.5px; box-shadow:0 2px 6px rgba(27,42,46,.28); }
.wheel-center:active { transform:translate(-50%,-50%) scale(.92); }
.wheel-center-busy { background:#4C5C5B; opacity:.92; }
.spin-result { min-height:36px; display:flex; align-items:center; justify-content:center; margin:0 0 6px; color:#0F3D36; font-size:15px; font-weight:800; text-align:center; opacity:0; transform:scale(.98); transition:opacity .18s ease, transform .18s ease; }
.spin-result-show { opacity:1; transform:scale(1); }
.spin-result-running { color:#4C5C5B; font-size:12.5px; font-weight:600; animation:spin-status-pulse .7s ease-in-out infinite alternate; }
.spin-result-final { color:#0F3D36; animation:spin-result-pop .5s ease; }
.people-label { margin-top:7px; }
.people-card { padding:12px 14px; border:1px solid #DED8C6; border-radius:14px; background:#FFFDF6; }
.add-row { display:flex; align-items:center; gap:7px; margin-bottom:5px; }
.name-input { flex:1; min-width:0; height:39px; box-sizing:border-box; padding:0 11px; border:1px solid #DED8C6; border-radius:8px; background:#F6F3EA; color:#1B2A2E; font-size:14px; }
.add-button { width:39px; height:39px; flex:0 0 39px; display:flex; align-items:center; justify-content:center; border-radius:8px; background:#0F3D36; color:#FFFDF6; font-size:25px; font-weight:300; }
.add-button-disabled, .remove-button-disabled { opacity:.55; }
.person-row { position:relative; min-height:38px; display:flex; align-items:center; gap:8px; padding:3px 2px; border-bottom:0.5px solid #EAE4D5; }
.person-row:last-child { border-bottom:0; }
.person-avatar { width:24px; height:24px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#0F3D36; color:#FFFDF6; font-size:10px; font-weight:700; }
.avatar-1 { background:#B8842A; }
.avatar-2 { background:#3E6E8E; }
.avatar-3 { background:#A8506E; }
.avatar-4 { background:#C05B3C; }
.avatar-5 { background:#4C5C5B; }
.avatar-6 { background:#6B8E7A; }
.avatar-7 { background:#C99A3C; }
.person-name { flex:1; min-width:0; font-size:13px; }
.remove-button { width:21px; height:21px; display:flex; align-items:center; justify-content:center; border:2px solid #FFFDF6; border-radius:50%; background:#C05B3C; color:#FFFDF6; font-size:15px; box-shadow:0 1.5px 4px rgba(192,91,60,.2); }
.empty-row { padding:14px 0; color:#8B928D; font-size:11.5px; text-align:center; }

@keyframes wheel-pointer-tick { from { transform:translate3d(-50%,0,0) rotate(-7deg); } to { transform:translate3d(-50%,0,0) rotate(7deg); } }
@keyframes spin-status-pulse { from { opacity:.55; transform:scale(.98); } to { opacity:1; transform:scale(1.02); } }
@keyframes spin-result-pop { 0% { opacity:0; transform:scale(.6); } 60% { transform:scale(1.1); } 100% { opacity:1; transform:scale(1); } }
