/* Responsive room and identity controls, isolated from the global button skin. */
.midpoint-page{padding-bottom:calc(40px + env(safe-area-inset-bottom))}
.midpoint-page .point-name{display:flex;align-items:center;min-width:0}.midpoint-page .point-nickname{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.midpoint-page .identity-me{flex-shrink:0}
.midpoint-page .mine-actions{flex-wrap:wrap}.midpoint-page .mine-actions button{width:auto;flex:1 1 120px;min-height:46px;height:auto;padding:10px 8px;white-space:normal;line-height:1.4}
.midpoint-page button.room-create-button{display:block;width:100%;min-width:0;height:50px;margin:14px 0 10px;padding:0 12px;box-sizing:border-box;border-radius:12px;background:#20584d;color:#fffefa;font-size:15px;line-height:50px}
.midpoint-page .room-entry-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center;min-width:0}
.midpoint-page .room-entry-row .input{width:100%;min-width:0;box-sizing:border-box;letter-spacing:1px}
.midpoint-page button.room-small-button{min-width:72px;max-width:100%;height:46px;margin:0;padding:0 10px;box-sizing:border-box;white-space:nowrap}
.midpoint-page .active-room-main{min-width:0;width:100%}.midpoint-page .active-room-code{max-width:100%;overflow-wrap:anywhere;letter-spacing:.12em}
.midpoint-page .active-room-actions{display:grid;width:100%;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
.midpoint-page button.room-action{display:flex;align-items:center;justify-content:center;width:100%;min-width:0;min-height:44px;height:auto;margin:0;padding:8px 6px;box-sizing:border-box;white-space:normal;line-height:1.35;text-align:center;border:1px solid #8ba99b;border-radius:9px;background:#fffefa;color:#17473f;font-size:14px}
.midpoint-page button.room-action.danger{border-color:#d98778;color:#a04435;background:#fff9f5}
.midpoint-page button.edit-my-point{display:block;width:100%;min-width:0;height:auto;min-height:46px;margin:14px 0 0;padding:10px;box-sizing:border-box;white-space:normal;line-height:1.4;border:1px solid #c7d7c8;border-radius:10px;background:#f3f6ed;color:#17473f;font-size:14px}
.midpoint-page .point-copy{overflow-wrap:anywhere;word-break:break-word}.midpoint-page .point-address{white-space:normal;overflow-wrap:anywhere;word-break:break-word}
.midpoint-page .account-identity{min-width:0}.midpoint-page .identity-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media(max-width:350px){.midpoint-page .room-entry-row{grid-template-columns:minmax(0,1fr)}.midpoint-page button.room-small-button{width:100%}.midpoint-page .active-room-actions{gap:6px}}

/* Compact native navigation and room layout. Keep natural content height for large text. */
.midpoint-page{padding-right:16px;padding-left:16px;padding-bottom:calc(24px + env(safe-area-inset-bottom))}
.midpoint-page .page-header{display:flex;align-items:center;gap:4px;min-height:44px;margin:0 -16px 12px;padding:0 8px;border:0;background:transparent}
.midpoint-page .back-button{display:flex;align-items:center;justify-content:flex-start;width:44px!important;min-width:44px;height:44px;box-sizing:border-box;border:0;background:transparent;color:#17473f;font-size:27px}
.midpoint-page .nav-right-space{height:44px;flex:0 0 auto}
.midpoint-page .result-toolbar{display:flex;justify-content:flex-end;min-height:44px;margin:-8px 0 4px}
.midpoint-page .result-toolbar button.adjust-button{width:auto;min-width:72px;min-height:44px;margin:0;padding:0 8px;background:transparent;color:#20584d;font-size:12px;line-height:1.35}
.midpoint-page .page-title{min-width:0;max-width:none;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px;line-height:1.3;text-align:center}
.midpoint-page button.adjust-button{min-width:44px;min-height:44px;height:auto;margin:0;padding:0 2px;justify-self:end;box-sizing:border-box;background:transparent;color:#17473f;font-size:12px;line-height:1.35;white-space:normal}
.midpoint-page .card{padding:14px;margin-bottom:12px;border-radius:14px}
.midpoint-page .room-card-head{gap:9px;margin-bottom:10px}.midpoint-page .room-title-line,.midpoint-page .point-heading-line{display:flex;align-items:center;gap:8px;min-width:0}.midpoint-page .room-card-title{font-size:15px}.midpoint-page .room-member-count{flex:0 0 auto;color:var(--ink-soft);font-size:12px}
.midpoint-page .section-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px}.midpoint-page button.point-edit-link{display:flex;align-items:center;justify-content:center;width:auto;min-width:44px;min-height:44px;height:auto;flex:0 0 auto;margin:0;padding:0 8px;box-sizing:border-box;border:0;background:transparent;color:#20584d;font-size:12px;line-height:1.3;white-space:nowrap}
.midpoint-page .point-row{padding:9px 0}.midpoint-page .point-name{font-size:14px}.midpoint-page .point-address{font-size:14px;line-height:1.5}.midpoint-page .mine-editor{padding:8px 0 0;margin-top:4px;border:0;border-radius:0;background:transparent}.midpoint-page .mine-editor .account-identity{display:none}.midpoint-page .mine-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.midpoint-page .mine-actions button{width:100%;min-width:0;min-height:44px;margin:0;padding:8px 6px;font-size:14px;line-height:1.35}.midpoint-page .mine-editor .input{height:52px;min-height:52px;line-height:48px;padding:0 10px;margin:4px 0;font-size:16px}.midpoint-page .address-suggestions{max-height:260px}.midpoint-page .suggestion-item{min-height:44px;padding:10px}.midpoint-page .clear-location{display:inline-flex;align-items:center;min-height:44px;margin:4px 0 0;padding:0 6px;line-height:1.4}
.midpoint-page .point-copy,.midpoint-page .point-address,.midpoint-page .suggestion-address{min-width:0;overflow-wrap:anywhere;word-break:break-word}.midpoint-page .point-nickname{max-width:100%}.midpoint-page .btn,.midpoint-page button.room-action,.midpoint-page button.room-small-button{height:auto;min-height:44px;line-height:1.35}.midpoint-page input{font-size:16px}
.midpoint-page .active-room{background:transparent;border:0;border-radius:0;padding:4px 0 0}.midpoint-page .active-room-main{width:auto}.midpoint-page .active-room-code{font-size:20px}.midpoint-page .active-room-actions{margin-top:8px}
.midpoint-page .point-member{display:block;padding:9px 0}
.midpoint-page .point-member-head{display:flex;align-items:center;gap:8px;min-height:44px}
.midpoint-page .point-member-head .point-copy{min-width:0;flex:1}
.midpoint-page .point-location-card{margin-top:7px;padding:10px 11px;border-radius:10px;background:#edf2e9}
.midpoint-page .point-location-label{color:#617368;font-size:13px;line-height:1.4}
.midpoint-page .point-saved-address{margin-top:3px;color:#163f3b;font-size:16px;line-height:1.5;white-space:normal;overflow-wrap:anywhere;word-break:break-word}
.midpoint-page .point-address-waiting{margin-top:5px;color:#737f7b;font-size:14px;line-height:1.5}
.midpoint-page .mine-editor{margin-top:12px;padding:12px 0 0;border-top:1px solid var(--line)}
@media(max-width:350px){.midpoint-page .point-heading-line{gap:5px}.midpoint-page .point-edit-link{padding:0 4px}}

/* Native inputs use their own text layout; keep vertical padding at zero and
   let the surrounding rows provide spacing so glyphs and placeholders stay visible. */
.midpoint-page input.input{display:block;width:100%;height:52px;min-height:52px;box-sizing:border-box;padding:0 10px;margin:4px 0;border:1px solid var(--line);border-radius:10px;background:#fffefa;color:var(--ink);font-size:16px;line-height:48px}
.midpoint-page .room-entry-row input.input{width:100%;min-width:0;margin:0}
.midpoint-page .local-search-row input.input{height:52px;min-height:52px;line-height:48px}
.midpoint-page .native-input-placeholder{color:#737f7b;font-size:15px;line-height:1.4}
.midpoint-page .room-card-head{display:flex;align-items:center;min-height:30px;margin:0 0 8px;gap:8px}
.midpoint-page .point-row{gap:7px;padding:4px 0}
.midpoint-page .point-edit-link{min-height:44px}
.midpoint-page button.calculate-button[disabled]{opacity:1;background:#e7eee4;color:#17473f;border:1px solid #d4dfd1}

.midpoint-page .local-valid-points-note{margin-top:7px;color:#66746a;font-size:12px;line-height:1.5}
