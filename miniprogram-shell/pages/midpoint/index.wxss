/* Same content geometry and sage result sheet as the web midpoint view. */
page { background:#f7f6f0; color:#163f3b; }
.midpoint-page { --paper:#f7f6f0; --paper-raised:#fffefa; --ink:#163f3b; --ink-soft:#737f7b; --green:#20584d; --line:#e5e4d9; box-sizing:border-box; width:100%; max-width:480px; margin:0 auto; padding-right:16px; padding-left:16px; padding-bottom:calc(40px + env(safe-area-inset-bottom)); background:var(--paper); color:var(--ink); }
.midpoint-page .page-header { display:grid; grid-template-columns:1fr auto 1fr; gap:8px; min-height:64px; margin:0 -16px 16px; padding:0 16px; border-bottom:1px solid var(--line); background:#faf9f4; }
.midpoint-page .back-button { width:44px; height:44px; margin:0; border:0; background:transparent; color:var(--ink); justify-self:start; font-size:29px; }
.midpoint-page .page-title { font-size:16px; font-weight:600; letter-spacing:.04em; text-align:center; white-space:nowrap; }
.adjust-button { min-width:44px; min-height:44px; justify-self:end; margin:0; padding:0 2px; border:0; background:transparent; color:#17473f; font-size:12px; line-height:44px; }
.midpoint-page .card { padding:17px; margin-bottom:16px; border:1px solid var(--line); border-radius:20px; background:var(--paper-raised); box-shadow:0 4px 20px rgba(37,65,47,.025); }
.midpoint-page .room-card-head { gap:12px; margin-bottom:14px; }.midpoint-page .room-card-icon { width:42px; height:42px; flex:0 0 42px; border-radius:13px; background:#e8efea; }.room-card-icon image { width:21px; height:21px; }
.midpoint-page .room-card-title { font-size:16px; font-weight:600; color:var(--ink); }.midpoint-page .room-card-sub { margin-top:2px; color:var(--ink-soft); font-size:12px; line-height:1.65; }
.midpoint-page .input { height:46px; padding:0 12px; margin:8px 0; border:1px solid var(--line); border-radius:11px; background:#f8f7f1; color:var(--ink); font-size:16px; }
.midpoint-page .room-entry-row { display:flex; gap:8px; }.midpoint-page .room-entry-row .input { width:0; flex:1; min-width:0; font-size:13px; }.midpoint-page .room-small-button { min-width:44px; height:46px; padding:0 12px; border-radius:11px; background:#20584d; color:#fffefa; font-size:13px; font-weight:500; white-space:nowrap; }.midpoint-page .room-small-button.outline { border:1px solid #20584d; background:transparent; color:#17473f; }
.midpoint-page .section-title { font-size:14px; font-weight:600; color:var(--ink); }.midpoint-page .muted,.midpoint-page .local-note { font-size:12px; color:var(--ink-soft); line-height:1.6; }.midpoint-page .local-note { padding:8px 0; background:transparent; }
.midpoint-page .point-row { gap:8px; padding:12px 0; border-color:var(--line); }.midpoint-page .point-avatar { width:29px; height:29px; flex:0 0 29px; font-size:12px; font-weight:500; background:#638b68; }.midpoint-page .self-avatar { background:#ee9476; }.midpoint-page .point-name { font-size:13px; font-weight:500; }.midpoint-page .point-address { font-size:13px; line-height:1.6; color:var(--ink-soft); }.midpoint-page .remove-point { width:44px; height:44px; flex:0 0 44px; border:0; background:transparent; font-size:20px; }.midpoint-page .row-arrow { font-size:22px; color:#617368; }
.midpoint-page .dashed-button { min-height:44px; padding:10px; margin-top:13px; border:1px dashed #d2dbcd; border-radius:11px; background:#f8faf4; color:#396a59; font-size:12px; font-weight:500; }
.midpoint-page .btn { min-height:46px; border-radius:11px; background:#20584d; color:#fffefa; font-size:14px; font-weight:500; }.midpoint-page .btn.secondary { border:1px solid #20584d; background:transparent; color:#17473f; }.midpoint-page .calculate-button { min-height:50px; margin:16px 0 0; border-radius:13px; }
.midpoint-page .mine-editor { padding:12px; margin-top:16px; border-radius:12px; background:#f8f7f1; }.midpoint-page .mine-actions { gap:8px; }.midpoint-page .editor-label { font-size:13px; font-weight:500; }.midpoint-page .text-action,.midpoint-page .map-link { min-height:44px; margin:0; padding:0 6px; line-height:44px; font-size:12px; color:#20584d; white-space:nowrap; }.midpoint-page .active-room { border:1px solid #dbe5d7; border-radius:12px; background:#edf2e9; flex-wrap:wrap; padding:10px; }.midpoint-page .active-room-actions { flex-wrap:wrap; }.midpoint-page .active-room-code { color:#20584d; }.midpoint-page .clear-location { color:#a34f39; }
.result-room-strip { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:8px 10px; margin-bottom:12px; border:1px solid #dbe5d7; border-radius:12px; background:#edf2e9; }.result-room-code { font-size:14px; font-weight:600; letter-spacing:.08em; }.result-room-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:0; }
.map-frame { margin:0 -16px; }.midpoint-page .midpoint-map { width:100%; height:415px; border:0; border-radius:0; background:#e9eee5; }.map-controls { position:absolute; right:16px; bottom:49px; padding:3px; border-radius:23px; background:#fffef9; box-shadow:0 4px 16px rgba(39,61,47,.15); }.map-control { display:block; width:44px; height:44px; line-height:44px; text-align:center; color:#34554b; font-size:24px; }.map-control.map-fit { height:52px; line-height:52px; border-bottom:1px solid #edf0e7; font-size:11px; }.map-note { position:absolute; left:12px; bottom:28px; max-width:calc(100% - 82px); padding:5px 8px; border-radius:7px; background:#fffef9; color:#596f61; font-size:10px; }
.result-sheet { position:relative; margin:0 -16px; padding:10px 20px 24px; border-radius:25px 25px 0 0; background:#fffefa; box-shadow:0 -5px 23px rgba(41,55,41,.035); }.sheet-handle { width:30px; height:4px; margin:0 auto 19px; border-radius:5px; background:#d9d8cc; }.results-title { color:#163f3b; font-size:25px; line-height:1.4; font-weight:600; letter-spacing:-.04em; }.results-subtitle { margin-top:3px; color:#737f7b; font-size:13px; line-height:1.6; }
.poi-filters { display:flex; gap:8px; margin:14px 0 6px; }.poi-filters button { width:0; flex:1; min-height:44px; margin:0; padding:8px 4px; border:0; border-radius:999px; background:#f4f3ed; color:#66746a; font-size:13px; line-height:28px; }.poi-filters button.selected { background:#20584d; color:#fffefa; font-weight:600; }
.result-poi-row { display:flex; align-items:center; min-height:92px; gap:14px; padding:12px 0; border-bottom:1px solid #eeeee5; }.poi-cover { width:92px; height:66px; flex:0 0 92px; border-radius:13px; background:#e9eee1; }.poi-copy { flex:1; min-width:0; }.poi-name { margin-bottom:5px; font-size:15px; line-height:1.5; font-weight:600; }.poi-meta { color:#737f7b; font-size:11px; line-height:1.6; }.poi-chevron { width:14px; font-size:22px; font-weight:300; color:#617368; }
.poi-detail { padding:14px; margin:0 0 8px; border:1px solid #e5e4d9; border-radius:12px; background:#fafaf4; }.detail-address { color:#52665c; font-size:13px; line-height:1.7; }.midpoint-page .detail-meta { font-size:11px; line-height:1.6; color:#737f7b; }.detail-category { margin-top:10px; border:1px solid #e5e4d9; border-radius:10px; overflow:hidden; }.category-head { display:flex; justify-content:space-between; align-items:center; min-height:44px; padding:0 10px; color:#20584d; font-size:13px; background:#eff2e9; }.category-place { min-height:44px; padding:10px; border-top:1px solid #e5e4d9; font-size:13px; }.query-error { padding:8px; margin:8px 0; color:#a34f39; font-size:12px; line-height:1.6; background:#f4e9df; border-radius:9px; }.midpoint-page .empty-copy { padding:16px 0; color:#737f7b; font-size:13px; }.midpoint-page .vote-option { min-width:44px; min-height:44px; height:auto; padding:4px 10px; border-color:#d6e1d1; font-size:12px; background:#f7f8f0; }.midpoint-page .vote-option.selected { background:#20584d; color:#fffefa; }.midpoint-page .vote-summary,.midpoint-page .decision-participation { font-size:11px; line-height:1.6; color:#737f7b; }.midpoint-page .decision-status { background:#20584d; font-size:12px; }
.midpoint-page .blind-entry { min-height:52px; gap:10px; margin:8px 0 0; padding:11px 16px; border-radius:16px; background:#e7eee4; color:#17473f; }.midpoint-page .blind-icon { width:24px; height:24px; flex:0 0 24px; border-radius:0; background:transparent; color:#20584d; font-size:23px; }.midpoint-page .blind-title { margin:0; color:#17473f; font-size:14px; font-weight:600; }.manual-actions { display:flex; flex-wrap:wrap; justify-content:space-between; gap:4px; }
.midpoint-page .swipe-cover { width:100%; height:130px; margin-bottom:18px; border-radius:14px; background:#e9eadf; }.midpoint-page .swipe-card,.midpoint-page .swipe-shadow-card { border:1px solid #e5e4d9; background:#fffefa; }.midpoint-page .swipe-card { border-radius:22px; }.midpoint-page .swipe-back { background:#f7f6f0; }.midpoint-page .swipe-name { color:#163f3b; font-size:25px; font-weight:600; }.midpoint-page .place-tag { color:#6e856b; background:#edf0e6; font-size:11px; }.midpoint-page .swipe-address { color:#737f7b; font-size:13px; }.midpoint-page .swipe-button { width:56px; height:56px; font-size:26px; }.midpoint-page .swipe-stage { min-height:360px; height:70vh; max-height:500px; }.midpoint-page .swipe-card,.midpoint-page .swipe-shadow-card { height:calc(100% - 26px); }.midpoint-page .swipe-face { padding:22px; }.midpoint-page .swipe-button.like { border-color:#20584d; color:#20584d; }
@media (max-width:360px) { .midpoint-page .midpoint-map { height:355px; }.poi-cover { width:78px; flex-basis:78px; }.result-sheet { padding-right:16px; padding-left:16px; } }
@media (min-width:440px) { .midpoint-page .midpoint-map { height:440px; } }
.local-editor-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; }.local-editor-heading .editor-label { margin:0; }.local-search-row { display:flex; align-items:center; gap:7px; }.midpoint-page .local-search-row .input { flex:1; width:0; min-width:0; margin:0; font-size:13px; }.midpoint-page .local-search-row .room-small-button { min-width:48px; height:44px; flex:0 0 auto; margin:0; padding:0 10px; line-height:44px; font-size:12px; }.local-search-note,.local-search-message { margin-top:8px; color:#737f7b; font-size:11px; line-height:1.6; }.local-search-message.search-error { color:#a34f39; }.midpoint-page .local-point-editor .suggestion-status { padding:8px 0; font-size:12px; }.midpoint-page .local-point-editor .address-suggestions { max-height:210px; border-color:#e5e4d9; border-radius:10px; }.midpoint-page .local-point-editor .suggestion-item { padding:11px; }.midpoint-page .local-point-editor .suggestion-name { font-size:13px; }.midpoint-page .local-point-editor .suggestion-address { font-size:11px; }.midpoint-page .local-map-choice { width:100%; margin-top:4px; text-align:left; }
.account-identity{display:flex;align-items:center;gap:9px;margin:12px 0}.identity-avatar{flex-shrink:0;width:38px;height:38px;border-radius:50%;background:#E4ECE1}.identity-placeholder{display:flex;align-items:center;justify-content:center;color:#0F3D36;font-size:16px;font-weight:600}.identity-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#0F3D36;font-size:14px;font-weight:600}.identity-me{display:inline-block;margin-left:5px;padding:2px 7px;border-radius:10px;background:#E7EFEB;color:#0F3D36;font-size:10px;line-height:16px;font-weight:500}
