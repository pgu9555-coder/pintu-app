<view class="page midpoint-page" style="padding-top: {{headerMetrics.statusBarPx}}px;">
  <view class="page-header" style="height: {{headerMetrics.headerHeightPx}}px;">
    <view class="back-button" bindtap="goBack">‹</view>
    <view class="page-title">{{screen === 'swipe' ? '吃什么盲盒' : '寻找中点'}}</view>
    <view class="nav-right-space" style="width: {{headerMetrics.capsuleInsetRightPx}}px;"></view>
  </view>

  <block wx:if="{{screen === 'swipe'}}">
    <view class="swipe-progress">{{swipeFinished ? '挑选完成' : (swipeIndex + 1) + ' / ' + swipeDeck.length}}</view>
    <view wx:if="{{swipeCurrent}}" class="swipe-stage">
      <view class="swipe-shadow-card shadow-two"></view>
      <view class="swipe-shadow-card shadow-one"></view>
      <view class="swipe-card" style="{{swipeCardStyle}}" bindtouchstart="swipeTouchStart" bindtouchmove="swipeTouchMove" bindtouchend="swipeTouchEnd">
        <view class="swipe-card-inner {{swipeFlipped ? 'flipped' : ''}}">
          <view class="swipe-face swipe-front">
            <image class="swipe-cover" src="{{swipeCurrent.cover}}" mode="aspectFill" binderror="coverError" data-id="{{swipeCurrent.id}}" />
            <view class="place-tag">共同候选</view>
            <view class="swipe-name">{{swipeCurrent.name}}</view>
            <view class="swipe-address">{{swipeCurrent.typeStr || '地图选择地点'}}</view>
            <view wx:if="{{swipeCurrent.dist}}" class="swipe-distance">距参考中点约 {{swipeCurrent.dist}} 米</view>
            <button class="map-link" bindtap="flipSwipeCard">翻面看地点详情</button>
          </view>
          <view class="swipe-face swipe-back">
            <view class="place-tag">地点详情</view>
            <view class="swipe-name">{{swipeCurrent.name}}</view>
            <view class="swipe-address">地址：{{swipeCurrent.address || swipeCurrent.typeStr || '暂无详细地址'}}</view>
            <view wx:if="{{swipeCurrent.category}}" class="swipe-address">分类：{{swipeCurrent.category}}</view>
            <view wx:if="{{swipeCurrent.dist}}" class="swipe-distance">距参考中点约 {{swipeCurrent.dist}} 米</view>
            <view wx:if="{{swipeCurrent.phone || swipeCurrent.rating || swipeCurrent.averageCost}}" class="detail-meta">
              <text wx:if="{{swipeCurrent.phone}}">电话 {{swipeCurrent.phone}}</text>
              <text wx:if="{{swipeCurrent.rating}}">评分 {{swipeCurrent.rating}}</text>
              <text wx:if="{{swipeCurrent.averageCost}}">人均 ¥{{swipeCurrent.averageCost}}</text>
            </view>
            <view wx:if="{{swipeDetail.loading}}" class="muted">正在加载详情…</view>
            <view wx:if="{{swipeDetail.error}}" class="query-error">{{swipeDetail.error}}<button class="text-action" data-id="{{swipeCurrent.id}}" bindtap="retryPoi">重新加载</button></view>
            <view wx:if="{{swipeDetail.loaded}}" class="muted">{{swipeDetail.info.address}} {{swipeDetail.info.phone}}</view>
            <button class="text-action" data-id="{{swipeCurrent.id}}" bindtap="showSwipeDetails">查看附近分类与更多</button>
            <view class="detail-actions">
              <button class="map-link" data-name="{{swipeCurrent.name}}" bindtap="copyCandidateName">复制名称</button>
              <button class="map-link" data-address="{{swipeCurrent.address}}" data-type="{{swipeCurrent.typeStr}}" bindtap="copyCandidateAddress">复制地址</button>
              <button class="map-link" data-lat="{{swipeCurrent.lat}}" data-lng="{{swipeCurrent.lng}}" data-name="{{swipeCurrent.name}}" data-address="{{swipeCurrent.address}}" data-type="{{swipeCurrent.typeStr}}" bindtap="openCandidate">地图导航</button>
            </view>
            <button class="map-link" bindtap="flipSwipeCard">翻回正面</button>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{swipeCurrent}}" class="swipe-actions">
      <button class="swipe-button pass" bindtap="swipeAction" data-action="pass" disabled="{{swipeVoteBusy}}">×</button>
      <button class="swipe-button like" bindtap="swipeAction" data-action="like" disabled="{{swipeVoteBusy}}">♥</button>
    </view>
    <view wx:if="{{swipeFinished}}" class="card swipe-result">
      <view class="result-icon">✓</view>
      <view class="title">留下了 {{swipeLikes.length}} 个心动选择</view>
      <view wx:if="{{!swipeLikes.length}}" class="empty-copy">这轮没有心动地点，再挑一次也可以。</view>
      <view wx:for="{{swipeLikes}}" wx:key="id" class="liked-row">
        <view class="liked-index">{{index + 1}}</view>
        <view class="liked-copy">
          <view class="liked-name">{{item.name}}</view>
          <view class="muted">{{item.address || item.typeStr || '地图选择地点'}}</view>
          <view wx:if="{{item.category}}" class="muted">{{item.category}}</view>
          <view wx:if="{{item.phone || item.rating || item.averageCost}}" class="detail-meta compact-meta"><text wx:if="{{item.phone}}">电话 {{item.phone}}</text><text wx:if="{{item.rating}}">评分 {{item.rating}}</text><text wx:if="{{item.averageCost}}">人均 ¥{{item.averageCost}}</text></view>
          <view class="candidate-actions"><button class="text-action map-text" data-name="{{item.name}}" catchtap="copyCandidateName">复制名称</button><button class="text-action map-text" data-address="{{item.address}}" data-type="{{item.typeStr}}" catchtap="copyCandidateAddress">复制地址</button><button class="text-action map-text" data-lat="{{item.lat}}" data-lng="{{item.lng}}" data-name="{{item.name}}" data-address="{{item.address}}" data-type="{{item.typeStr}}" catchtap="openCandidate">地图导航</button></view>
        </view>
      </view>
      <button class="btn" bindtap="restartSwipe">再挑一次</button>
      <button class="btn secondary" bindtap="backFromSwipe">返回公平中点</button>
    </view>
  </block>

  <block wx:else>
    <block wx:if="{{!resultMode}}">
    <view class="card collaboration-card">
      <view class="room-card-head room-title-line">
        <view class="room-card-title">碰面房间</view><view wx:if="{{room}}" class="room-member-count">{{people.length}} 位成员</view>
      </view>
      <block wx:if="{{room}}">
        <view class="active-room">
          <view class="active-room-main"><view class="active-room-label">房间码</view><view class="active-room-code">{{room.code}}</view></view>
          <view class="active-room-actions">
            <button class="room-action" bindtap="copyCode" disabled="{{busy}}">复制房间码</button>
            <button class="room-action" open-type="share" disabled="{{busy}}">转发到群聊</button>
            <button wx:if="{{isOwner}}" class="room-action" bindtap="transferOwner" disabled="{{busy}}">转交房主</button>
            <button wx:if="{{isOwner}}" class="room-action danger" bindtap="exitRoom" disabled="{{busy}}">解散房间</button>
            <button wx:else class="room-action" bindtap="exitRoom" disabled="{{busy}}">退出房间</button>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="account-identity"><image wx:if="{{accountAvatar}}" class="identity-avatar" src="{{accountAvatar}}" mode="aspectFill" /><view wx:else class="identity-avatar identity-placeholder"><image src="/assets/icons/person.svg" mode="aspectFit" /></view><text class="identity-name">{{name}}</text><text class="identity-me">我</text></view>
        <button class="room-create-button" bindtap="create" loading="{{busy}}" disabled="{{busy}}">＋ 创建房间</button>
        <view class="room-entry-row">
          <input class="input code-input" placeholder="输入 8 位房间码" placeholder-class="native-input-placeholder" value="{{code}}" maxlength="8" bindinput="codeInput" />
          <button class="room-small-button outline" bindtap="join" loading="{{busy}}" disabled="{{busy}}">加入房间</button>
        </view>
      </block>
    </view>

    <view wx:if="{{room}}" class="card point-card">
      <view class="section-heading">
        <view class="point-heading-line"><view class="section-title">{{room ? '大家的出发点' : '大家的出发地址'}}</view></view>
      </view>

      <block wx:if="{{room}}">
        <view wx:for="{{people}}" wx:key="uid" class="point-row point-member">
          <view class="point-member-head">
            <image wx:if="{{item.ownAvatar}}" class="point-avatar" src="{{item.ownAvatar}}" mode="aspectFill" /><view wx:else class="point-avatar">{{item.name[0]}}</view>
            <view class="point-copy"><view class="point-name"><text class="point-nickname">{{item.name}}</text><text wx:if="{{item.isSelf}}" class="identity-me">我</text></view></view>
            <button wx:if="{{item.isSelf}}" class="point-edit-link" bindtap="toggleMineEditor" disabled="{{busy}}">{{mineEditorOpen ? '收起' : (mineHasSavedLocation ? '修改' : '填写')}}</button>
          </view>
          <view wx:if="{{item.address}}" class="point-location-card">
            <view class="point-location-label">当前地点</view>
            <view class="point-saved-address">{{item.address}}</view>
          </view>
          <view wx:else class="point-saved-address point-address-waiting">等待填写出发点</view>
        </view>
        <view wx:if="{{mineEditorOpen}}" class="mine-editor">
          <view class="editor-label">搜索或修改地点</view>
          <input class="input" placeholder="搜索地点名称或地址" placeholder-class="native-input-placeholder" value="{{mineAddress}}" maxlength="120" bindinput="mineAddressInput" bindfocus="mineAddressFocus" />
          <view wx:if="{{addressSearchLoading}}" class="suggestion-status">正在搜索地点…</view>
          <scroll-view wx:if="{{addressSuggestionsVisible && addressSuggestions.length}}" class="address-suggestions" scroll-y="true">
            <view class="suggestion-hint">请选择具体地点（可上下滑动查看更多）</view>
            <view wx:for="{{addressSuggestions}}" wx:key="id" class="suggestion-item" data-index="{{index}}" bindtap="selectAddressSuggestion">
              <view class="suggestion-name">{{item.name}}</view>
              <view class="suggestion-address">{{item.address}}</view>
            </view>
          </scroll-view>
          <view wx:if="{{!amapConfigured}}" class="map-config-note">为保证位置准确，请点“从地图选点”，可在微信地图里搜索具体地点。</view>
          <view class="mine-actions">
            <button class="btn secondary compact-button" bindtap="chooseLocation" loading="{{busy}}" disabled="{{busy}}">从地图选点</button>
            <button class="btn compact-button" bindtap="saveMeetupLocation" loading="{{pointSyncBusy}}" disabled="{{busy}}">保存我的地点</button>
          </view>
          <view wx:if="{{pointSyncPending || pointSyncText}}" class="point-sync-state {{pointSyncPending ? 'pending' : ''}}">{{pointSyncText}}</view>
          <button wx:if="{{mineHasSavedLocation}}" class="text-action clear-location" bindtap="clearMeetupLocation" disabled="{{busy}}">清除已保存的出发点</button>
        </view>
        <view class="room-manual-points">
          <view class="section-title">补充同行者出发点 <text class="local-only-tag">手动添加 · 仅本机</text></view>
          <view wx:for="{{roomManualPoints}}" wx:key="id" class="point-row local-person-row">
            <view class="point-copy" bindtap="editRoomManualPoint" data-id="{{item.id}}"><view class="point-name">{{item.name || '同行者'}} <text class="local-only-tag">仅本机</text></view><view class="point-address">{{item.address || '尚未选择有效地点'}}</view></view>
            <button class="point-edit-link" bindtap="editRoomManualPoint" data-id="{{item.id}}">编辑</button>
            <button class="text-action clear-location" bindtap="removeRoomManualPoint" data-id="{{item.id}}">删除</button>
          </view>
          <view wx:if="{{roomManualEditorId}}" class="mine-editor local-point-editor">
            <view class="local-editor-heading"><view class="editor-label">手动出发点 · 仅本机</view><button class="text-action" bindtap="closeRoomManualEditor">收起</button></view>
            <input class="input" value="{{roomManualName}}" placeholder="同行者称呼" placeholder-class="native-input-placeholder" maxlength="48" bindinput="roomManualNameInput" />
            <view class="local-search-row"><input class="input" value="{{localAddressQuery}}" placeholder="输入城市、地点名称或地址" placeholder-class="native-input-placeholder" maxlength="80" confirm-type="search" bindinput="roomManualAddressInput" bindconfirm="searchRoomManualAddress" /><button class="room-small-button" bindtap="searchRoomManualAddress" loading="{{localAddressSearchLoading}}" disabled="{{localAddressSearchLoading}}">搜索</button></view>
            <view class="local-search-note">选择搜索到的地点会保存真实坐标；也可以从微信地图选点。</view>
            <view wx:if="{{localAddressSearchLoading}}" class="suggestion-status">正在搜索地点…</view>
            <view wx:if="{{localAddressMessage}}" class="local-search-message {{localAddressError ? 'search-error' : ''}}">{{localAddressMessage}}</view>
            <scroll-view wx:if="{{localAddressSuggestions.length}}" class="address-suggestions" scroll-y="true"><view wx:for="{{localAddressSuggestions}}" wx:key="index" class="suggestion-item" data-index="{{index}}" bindtap="selectRoomManualAddress"><view class="suggestion-name">{{item.name}}</view><view class="suggestion-address">{{item.address}}</view></view></scroll-view>
            <button class="text-action local-map-choice" bindtap="chooseRoomManualPoint">微信地图选点</button>
          </view>
          <button wx:if="{{!roomManualEditorId}}" class="dashed-button" bindtap="addRoomManualPoint" disabled="{{busy}}">＋ 手动添加出发点 · 仅本机</button>
          <view wx:if="{{roomManualPoints.length}}" class="local-search-note local-valid-points-note">仅本机参考；不会加入成员或共同投票。有效地点 {{roomActualValidPointCount}} + {{roomManualValidPointCount}} 个。</view>
        </view>
        <button wx:if="{{roomManualPoints.length}}" class="btn calculate-button local-reference-button" bindtap="calculateRoomManualMidpoint" disabled="{{roomActualValidPointCount + roomManualValidPointCount < 2 || busy}}">计算本机参考中点</button>
        <button wx:else class="btn calculate-button" bindtap="showRoomResults" disabled="{{!center || busy}}">寻找碰面点</button>
        <view wx:if="{{!center && !roomManualPoints.length}}" class="local-valid-points-note">至少两位成员分别保存有效出发点后即可查询。</view>
      </block>

      <block wx:else>
        <view wx:for="{{localPoints}}" wx:key="id" class="point-row local-person-row selectable" bindtap="openLocalPointEditor" data-id="{{item.id}}" role="button" aria-label="编辑{{item.label}}的出发地点">
          <view class="point-avatar {{item.isSelf ? 'self-avatar' : 'friend-avatar'}}">
            <image wx:if="{{item.isSelf && item.avatarFileId}}" class="point-avatar-image" src="{{item.avatarFileId}}" mode="aspectFill" />
            <text wx:else>{{item.initial}}</text>
          </view>
          <view class="point-copy"><view class="point-name">{{item.label}}</view><view class="point-address">{{item.address || '输入地址或从地图选点'}}</view></view>
          <view wx:if="{{!item.isSelf && localPoints.length > 2}}" class="remove-point" catchtap="removeLocalPoint" data-id="{{item.id}}" role="button" aria-label="删除这位朋友">×</view>
          <view wx:else class="row-arrow">›</view>
        </view>
        <view wx:if="{{localPointEditorId}}" class="mine-editor local-point-editor">
          <view class="local-editor-heading"><view class="editor-label">{{localPointEditorLabel}}的出发地点</view><button class="text-action" bindtap="closeLocalPointEditor">收起</button></view>
          <view class="local-search-row"><input class="input" value="{{localAddressQuery}}" placeholder="输入城市、地点名称或地址" placeholder-class="native-input-placeholder" maxlength="80" confirm-type="search" bindinput="localAddressInput" bindconfirm="searchLocalPointAddress" /><button class="room-small-button" bindtap="searchLocalPointAddress" loading="{{localAddressSearchLoading}}" disabled="{{busy || localAddressSearchLoading}}">搜索</button></view>
          <view class="local-search-note">搜索关键词经云端高德查询，不读取当前位置。</view>
          <view wx:if="{{localAddressSearchLoading}}" class="suggestion-status">正在搜索地点…</view>
          <view wx:if="{{localAddressMessage}}" class="local-search-message {{localAddressError ? 'search-error' : ''}}">{{localAddressMessage}}</view>
          <scroll-view wx:if="{{localAddressSuggestions.length}}" class="address-suggestions" scroll-y="true">
            <view wx:for="{{localAddressSuggestions}}" wx:key="index" class="suggestion-item" data-index="{{index}}" bindtap="selectLocalAddressSuggestion" role="button" aria-label="使用{{item.name}}作为出发点"><view class="suggestion-name">{{item.name}}</view><view class="suggestion-address">{{item.address}}</view></view>
          </scroll-view>
          <button class="text-action local-map-choice" bindtap="chooseLocalPoint" data-id="{{localPointEditorId}}" disabled="{{busy}}">地图选点</button>
        </view>
        <button wx:if="{{localPoints.length < 6}}" class="dashed-button" bindtap="addLocalPoint">＋ 添加一位出发的朋友</button>
        <button class="btn calculate-button" bindtap="calculateLocalMidpoint" disabled="{{localValidPointCount < 2 || localValidPointCount < localPoints.length}}">寻找碰面点</button>
        <view class="local-search-note local-valid-points-note">至少填写并选择 2 个有效出发点后即可查询（当前 {{localValidPointCount}} 个）</view>
      </block>
    </view>

    </block>
    <block wx:if="{{resultMode && center}}">
      <view class="result-toolbar"><button class="adjust-button" bindtap="adjustPlaces">调整地点</button></view>
      <view wx:if="{{roomManualReference}}" class="local-reference-notice">本机参考 · 包含手动添加地点，不会同步给房间成员，也不参与共同投票。<button class="text-action" bindtap="showRoomResults" disabled="{{roomActualValidPointCount < 2 || busy}}">查看房间共同中点</button></view>
      <view wx:if="{{room}}" class="result-room-strip">
        <view><view class="muted">多人协作 · {{syncText}}</view><view class="result-room-code">{{room.code}}</view></view>
        <view class="result-room-actions"><button class="text-action" bindtap="copyCode">复制</button><button class="text-action" open-type="share">邀请</button><button wx:if="{{isOwner}}" class="text-action" bindtap="transferOwner">房主管理</button><button class="text-action" bindtap="exitRoom">{{isOwner ? '解散' : '退出'}}</button></view>
      </view>
      <view class="map-frame">
        <map id="midpointMap" class="midpoint-map" latitude="{{center.latitude}}" longitude="{{center.longitude}}" scale="{{mapScale}}" markers="{{markers}}" polyline="{{polyline}}" include-points="{{mapFitPoints}}" enable-scroll="true" enable-zoom="true" show-location="false">
          <cover-view class="map-controls"><cover-view class="map-control map-fit" bindtap="mapAction" data-action="fit">⌗ 总览</cover-view><cover-view class="map-control" bindtap="mapAction" data-action="in">＋</cover-view><cover-view class="map-control" bindtap="mapAction" data-action="out">−</cover-view></cover-view>
          <cover-view class="map-note">几何参考点，实际路程可能不同</cover-view>
        </map>
      </view>
      <view class="result-sheet">
        <view class="sheet-handle"></view>
        <view class="results-title">附近见，刚刚好</view>
        <view class="results-subtitle">{{mapLoading ? '正在寻找附近的好去处' : '为你找到 ' + resultCount + ' 个好去处'}}</view>
        <view class="poi-filters"><button class="{{filter === 'all' ? 'selected' : ''}}" bindtap="setFilter" data-filter="all">全部</button><button class="{{filter === 'drink' ? 'selected' : ''}}" bindtap="setFilter" data-filter="drink">咖啡</button><button class="{{filter === 'food' ? 'selected' : ''}}" bindtap="setFilter" data-filter="food">餐厅</button><button class="{{filter === 'mall' ? 'selected' : ''}}" bindtap="setFilter" data-filter="mall">商圈</button></view>
        <view wx:if="{{mapLoading}}" class="empty-copy centered">正在查询附近地点…</view>
        <view wx:if="{{mapError}}" class="query-error">{{mapError}}<button class="text-action" bindtap="retryMapSearch">重新加载</button></view>
        <view wx:if="{{!mapLoading && !mapError && !resultRows.length}}" class="empty-copy centered">这个分类暂时没有地点，换一类看看吧</view>
        <view wx:if="{{room && decisionCandidates.length}}" class="decision-participation">已有 {{decisionParticipantCount}} / {{decisionMemberCount}} 位成员参与投票</view>
        <view wx:if="{{decisionConfirmed}}" class="decision-status">✓ 已确定：{{confirmedCandidate.name}}</view>
        <block wx:for="{{resultRows}}" wx:key="id">
          <view class="result-poi-row" bindtap="togglePoi" data-id="{{item.id}}">
            <image class="poi-cover" src="{{item.cover}}" mode="aspectFill" binderror="coverError" data-id="{{item.id}}" />
            <view class="poi-copy"><view class="poi-name">{{item.name}}</view><view class="poi-meta">{{item.isMall ? '商圈' : item.isDrink ? '咖啡 · 茶饮' : '餐厅'}} · 距中点约 {{item.dist}} 米</view></view><view class="poi-chevron">{{item.expanded ? '⌄' : '›'}}</view>
          </view>
          <view wx:if="{{item.expanded}}" class="poi-detail">
            <view wx:if="{{item.details.loading}}" class="empty-copy">正在查这里都有什么…</view>
            <view wx:if="{{item.details.error}}" class="query-error">{{item.details.error}}<button class="text-action" data-id="{{item.id}}" bindtap="retryPoi">重新加载</button></view>
            <view class="detail-address">{{item.details.info.address || item.address || item.typeStr || '暂无详细地址'}}</view>
            <view class="detail-meta compact-meta"><text wx:if="{{item.details.info.phone || item.phone}}">电话 {{item.details.info.phone || item.phone}}</text><text wx:if="{{item.details.info.rating || item.rating}}">评分 {{item.details.info.rating || item.rating}}</text><text wx:if="{{item.details.info.averageCost || item.averageCost}}">人均 ¥{{item.details.info.averageCost || item.averageCost}}</text></view>
            <view wx:if="{{item.details.loaded && !item.details.info.name}}" class="muted">地图暂未收录更多基础资料。</view>
            <view wx:for="{{item.details.categories}}" wx:for-item="cat" wx:key="key" class="detail-category">
              <view class="category-head" bindtap="toggleCategory" data-id="{{item.id}}" data-key="{{cat.key}}"><text>{{cat.label}}</text><text>{{cat.total}} {{cat.expanded ? '⌄' : '›'}}</text></view>
              <block wx:if="{{cat.expanded}}"><view wx:for="{{cat.pois}}" wx:for-item="place" wx:key="id" class="category-place" bindtap="openCandidate" data-name="{{place.name}}" data-address="{{place.address}}" data-lat="{{place.lat}}" data-lng="{{place.lng}}"><view>{{place.name}}</view><view class="muted">{{place.address || place.typeStr}} · {{place.dist}} 米 ›</view></view><view wx:if="{{!cat.pois.length}}" class="muted">暂无同类地点</view><view wx:if="{{cat.error}}" class="query-error">{{cat.error}}</view><button wx:if="{{cat.pois.length < cat.total && cat.page < 4}}" class="text-action" bindtap="moreCategory" data-id="{{item.id}}" data-key="{{cat.key}}" disabled="{{cat.loading}}">{{cat.loading ? '加载中…' : cat.error ? '重试加载' : '加载更多'}}</button><view wx:if="{{cat.capped}}" class="muted">最多展示前 200 个地点</view></block>
            </view>
            <view class="candidate-actions"><button class="text-action" data-name="{{item.name}}" bindtap="copyCandidateName">复制名称</button><button class="text-action" data-address="{{item.address || item.details.info.address}}" data-type="{{item.typeStr}}" bindtap="copyCandidateAddress">复制地址</button><button class="text-action" data-name="{{item.name}}" data-address="{{item.address || item.details.info.address}}" data-lat="{{item.lat}}" data-lng="{{item.lng}}" bindtap="openCandidate">地图导航 ›</button></view>
            <block wx:if="{{room && !roomManualReference}}"><view class="vote-summary">想去 {{item.wantVotes}} · 可以 {{item.okVotes}} · 不去 {{item.noVotes}}</view><view wx:if="{{!decisionConfirmed}}" class="vote-row"><button class="vote-option {{item.wantSelected ? 'selected' : ''}}" bindtap="voteDecision" data-candidate-id="{{item.id}}" data-value="want" disabled="{{busy}}">想去</button><button class="vote-option {{item.okSelected ? 'selected' : ''}}" bindtap="voteDecision" data-candidate-id="{{item.id}}" data-value="ok" disabled="{{busy}}">可以</button><button class="vote-option {{item.noSelected ? 'selected' : ''}}" bindtap="voteDecision" data-candidate-id="{{item.id}}" data-value="no" disabled="{{busy}}">不去</button><button wx:if="{{isOwner}}" class="text-action" bindtap="confirmDecision" data-candidate-id="{{item.id}}" disabled="{{busy}}">确定这里</button></view></block>
            <button wx:else class="text-action clear-location" data-id="{{item.id}}" bindtap="removeLocalCandidate">移除这个候选</button>
          </view>
        </block>
        <view wx:if="{{resultCount}}" class="blind-entry" bindtap="startSwipe"><view class="blind-icon">◇</view><view class="blind-copy"><view class="blind-title">让盲盒替你选</view></view><view class="row-arrow">›</view></view>
        <view class="manual-actions"><button wx:if="{{room && !roomManualReference && !decisionConfirmed}}" class="text-action" bindtap="addDecisionCandidate">＋ 从微信地图添加</button><button wx:if="{{!room || roomManualReference}}" class="text-action" bindtap="addLocalCandidate">＋ 从微信地图添加（仅本机）</button><button wx:if="{{room && !roomManualReference && isOwner && decisionConfirmed}}" class="text-action" bindtap="reopenDecision">重新选择共同去处</button><button class="text-action" bindtap="openCenter">打开参考中点</button></view>
      </view>
    </block>
  </block>
</view>
