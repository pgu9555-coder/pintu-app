.data-tools{padding-top:28px}.backup-intro{padding:4px 4px 22px}.eyebrow{font-size:12px;color:#6B8176;letter-spacing:1px;margin-bottom:9px}.backup-title{font-size:28px;font-weight:600;line-height:1.3;margin-bottom:10px;color:#153F38}.section-title{font-size:16px;font-weight:600;margin-bottom:12px}.backup-counts{display:flex;padding:8px 0 20px;gap:48px}.backup-counts>view{display:flex;flex-direction:column;font-size:12px;color:#728079;gap:5px}.count{font-size:29px;color:#20594F;line-height:1.2}.card button{margin-top:20px;width:100%;min-height:44px}.small{font-size:11px;margin-top:10px}.backup-note{font-size:12px;line-height:1.8;color:#7A8177;padding:6px 7px 14px}.backup-status{padding:14px;background:#E8EFE7;border-radius:13px;color:#20594F;font-size:13px;line-height:1.7;margin-bottom:16px}.text-button{background:transparent;color:#20594F;font-size:13px;min-height:44px}.text-button::after{border:0}
