page { background:#F7F1E6; color:#143D35; font: 28rpx -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; }
.page { padding:32rpx; }.card { background:#FFFDF8; border-radius:24rpx; padding:28rpx; margin-bottom:24rpx; box-shadow:0 8rpx 24rpx rgba(20,61,53,.08); }
.title { font-size:42rpx; font-weight:700; }.muted { color:#78847D; font-size:25rpx; }.gold { color:#B8842A; }.btn { background:#143D35; color:#fff; border-radius:14rpx; margin:16rpx 0; }.btn.gold { background:#B8842A; color:#fff; }.btn.danger { background:#9C433A; }.row { display:flex; align-items:center; gap:16rpx; }.input { background:#F3EBDD; border-radius:12rpx; padding:20rpx; margin:12rpx 0; }.divider { height:1rpx; background:#E6DBC8; margin:20rpx 0; }
